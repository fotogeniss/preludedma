---
// Ξεχωριστή σελίδα για το simulator, ώστε να έχει δική της διεύθυνση στη Google.
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Simulator from '../components/Simulator.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Simulator: δες το site ή την εφαρμογή σου πριν υπάρξει | Prelude"
  description="Διάλεξε κλάδο, ύφος και χρώμα, γράψε τα δικά σου κείμενα και δες ζωντανά ένα πρώτο σκίτσο του site, της εφαρμογής και του διαχειριστικού σου."
>
  <div class="wrap">
    <Nav />
    <header class="sp-hero sp-hero-sm">
      <nav class="crumbs mono" aria-label="Πλοήγηση"><a href="/">Αρχική</a><span aria-hidden="true">/</span><span aria-current="page">Simulator</span></nav>
      <span class="kicker-h1"><span class="live"></span>Simulator ιστοσελίδων & εφαρμογών</span>
      <h1 class="sp-title">Φτιάξε το δικό σου site σε λίγα δευτερόλεπτα</h1>
    </header>
  </div>
  <Simulator />
  <Contact />
  <Footer />
</Base>
