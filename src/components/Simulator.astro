---
import { presets, swatches, styles, type Kind } from '../data/simulator';
const kinds = Object.entries(presets) as [Kind, (typeof presets)[Kind]][];
---
<section class="s" id="lab" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="mono"><b>[ SYS.02 ]</b> Simulator</span>
        <h2 class="h2">Δες το δικό σου<br /><span class="ol">πριν υπάρξει</span></h2>
      </div>
      <p>Γράψε το όνομα της επιχείρησής σου, διάλεξε κλάδο, ύφος και χρώμα, και δες ένα πρώτο σκίτσο του site ή της εφαρμογής σου. Πάτα και τα μενού μέσα στο preview.</p>
    </div>

    <div class="sim-note" role="note">
      <span class="sim-badge mono">Demo</span>
      <p><strong>Demo.</strong> Ένα δείγμα για να δεις πώς δουλεύουμε. Το δικό σου project σχεδιάζεται από το μηδέν, μαζί σου.</p>
    </div>

    <div class="sim">
      <div class="ctrl" id="simctrl">
        <div class="ctabs" role="tablist" aria-label="Ρυθμίσεις preview">
          <button type="button" role="tab" data-g="kind" aria-selected="true">Κλάδος</button>
          <button type="button" role="tab" data-g="mode" aria-selected="false">Τύπος</button>
          <button type="button" role="tab" data-g="style" aria-selected="false">Ύφος</button>
          <button type="button" role="tab" data-g="color" aria-selected="false">Χρώμα</button>
          <button type="button" role="tab" data-g="name" aria-selected="false">Όνομα</button>
          <button type="button" role="tab" data-g="extra" aria-selected="false">Extra</button>
        </div>
        <div class="cg" data-g="name">
          <label for="biz">Input // όνομα επιχείρησης</label>
          <input id="biz" value="Φούρνος Ελένη" maxlength="26" autocomplete="off" />
        </div>

        <div class="cg on" data-g="kind">
          <span class="lbl" id="lbl-kind">Input // κλάδος</span>
          <div class="opts" id="kinds" role="group" aria-labelledby="lbl-kind">
            {kinds.map(([key, p], i) => (
              <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-k={key}>{p.label}</button>
            ))}
          </div>
        </div>

        <div class="ctrl-row cg" data-g="mode">
          <div>
            <span class="lbl" id="lbl-mode">Output // τύπος</span>
            <div class="opts" id="mode" role="group" aria-labelledby="lbl-mode">
              <button type="button" aria-pressed="true" data-m="site">Ιστοσελίδα</button>
              <button type="button" aria-pressed="false" data-m="app">Εφαρμογή</button>
            </div>
          </div>
        </div>

        <div class="cg" data-g="style">
          <span class="lbl" id="lbl-style">Input // ύφος</span>
          <div class="opts" id="styles" role="group" aria-labelledby="lbl-style">
            {styles.map((s, i) => (
              <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-s={s.id}>{s.label}</button>
            ))}
          </div>
        </div>

        <div class="cg" data-g="color">
          <span class="lbl" id="lbl-color">Input // χρώμα</span>
          <div class="swatches" id="swatches" role="group" aria-labelledby="lbl-color">
            {swatches.map((c, i) => (
              <button
                type="button"
                class:list={['sw', { auto: c === 'auto' }]}
                aria-pressed={i === 0 ? 'true' : 'false'}
                data-c={c}
                style={c === 'auto' ? undefined : `--sw:${c}`}
                aria-label={c === 'auto' ? 'Χρώμα του κλάδου' : `Χρώμα ${c}`}
                title={c === 'auto' ? 'Του κλάδου' : c}
              ></button>
            ))}
            <label class="sw sw-custom" title="Δικό σου χρώμα">
              <input type="color" id="swcustom" value="#7B3FE4" aria-label="Διάλεξε δικό σου χρώμα" />
            </label>
          </div>
        </div>

        <div class="sim-btns cg" data-g="extra">
          <button type="button" class="btn btn-g sim-random" id="simrandom">Έκπληξη <span class="k" aria-hidden="true">⟳</span></button>
          <button type="button" class="btn btn-g sim-random" id="simflip" aria-pressed="false">Dark / Light <span class="k" aria-hidden="true">◐</span></button>
          <button type="button" class="btn btn-g sim-random" id="simauto">Auto demo <span class="k" aria-hidden="true">▶</span></button>
        </div>

        <div class="sim-console">
          <span class="lbl">Console</span>
          <div class="log" id="log" aria-live="polite"></div>
        </div>
      </div>

      <div class="view">
        <span class="corner mono" style="top:18px;left:22px">Preview // live</span>
        <span class="corner mono" style="top:18px;right:22px" id="res">1440 × 900</span>
        <button type="button" class="auto-pill mono" id="autoPill" hidden><i></i>Auto demo · πάτα για να το δοκιμάσεις</button>
        <span class="corner mono demo-mark" style="bottom:16px;left:22px">Demo · ενδεικτικό σκίτσο</span>

        <!-- Ιστοσελίδα -->
        <div class="mock mock-site" id="mSite" data-style="modern">
          <div class="mk-url"><i></i><i></i><i></i><span id="url"></span></div>
          <div class="mk-nav">
            <span class="mk-brand"><span class="mk-mark" id="sMark"></span><b id="sName"></b></span>
            <nav class="mk-links" id="sNav"></nav>
            <button type="button" class="mk-cart" id="sCartBtn" data-cart-open aria-label="Καλάθι" hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2 11h11l2-8H6"/><circle cx="9" cy="19" r="1.5"/><circle cx="17" cy="19" r="1.5"/></svg>
              <b id="sCartN">0</b>
            </button>
          </div>
          <div class="mk-body" id="sBody">
            <div class="mk-page" data-page="0">
              <div class="mk-hero">
                <div class="mk-copy">
                  <span class="mk-kicker" id="sKicker"></span>
                  <div class="mk-h" id="sHead"></div>
                  <p class="mk-sub" id="sSub"></p>
                  <div class="mk-ctas">
                    <button type="button" class="mk-btn" id="sCta"></button>
                    <span class="mk-hrs" id="sHoursMini"></span>
                  </div>
                </div>
                <div class="mk-pic">
                  <i class="art-a"></i><img class="art-ph" id="sPh" alt="" decoding="async" /><i class="art-b"></i>
                  <svg viewBox="0 0 24 24" class="art-glyph" id="sGlyph" aria-hidden="true"></svg>
                  <span class="mk-chip c1" id="sChip1"></span>
                  <span class="mk-chip c2" id="sChip2"></span>
                </div>
              </div>
              <div class="mk-marquee" aria-hidden="true"><div id="sMarq"></div></div>
              <div class="mk-feats" id="sFeats"></div>
              <div class="mk-gal" id="sGal"></div>
              <div class="mk-h mk-h2 mk-h3" id="sPopTitle"></div>
              <div class="mk-items" id="sPop"></div>
              <div class="mk-band">
                <b id="sBandT"></b>
                <button type="button" class="mk-btn" id="sBandB"></button>
              </div>
            </div>
            <div class="mk-page" data-page="1" hidden>
              <div class="mk-h mk-h2" id="sItemsTitle"></div>
              <div class="mk-items" id="sItems"></div>
            </div>
            <div class="mk-page" data-page="2" hidden>
              <div class="mk-h mk-h2">Επικοινωνία</div>
              <div class="mk-contact">
                <div class="mk-map"><span></span></div>
                <div>
                  <p><b>Ωράριο</b><br /><span id="sHours"></span></p>
                  <p><b>Διεύθυνση</b><br />Οδός Παραδείγματος 12</p>
                </div>
              </div>
              <form class="mk-form" id="sForm" novalidate>
                <input type="text" placeholder="Όνομα" aria-label="Όνομα (demo)" autocomplete="off" />
                <input type="text" placeholder="Τηλέφωνο" aria-label="Τηλέφωνο (demo)" autocomplete="off" />
                <button type="submit" class="mk-btn">Αποστολή</button>
                <p class="mk-ok" id="sFormOk" hidden>Στάλθηκε! (Είναι demo, δεν έφυγε τίποτα.)</p>
              </form>
            </div>
            <div class="mk-foot"><span id="sFoot"></span><span>Made by Prelude</span></div>
          </div>
          <div class="mk-sheet" id="sSheet" inert><div class="sh"></div></div>
          <div class="mk-toast" id="sToast" role="status" aria-live="polite"></div>
        </div>

        <!-- Εφαρμογή -->
        <div class="mock mock-app hide" id="mApp" data-style="modern">
          <div class="ap-status"><span>9:41</span><span class="ap-isl"></span><span>▮▮▮</span></div>
          <div class="ap-top">
            <span class="mk-mark" id="pMark"></span>
            <div><small id="pHi"></small><b id="pName"></b></div>
            <button type="button" class="mk-cart" id="pCartBtn" data-cart-open aria-label="Καλάθι" hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2 11h11l2-8H6"/><circle cx="9" cy="19" r="1.5"/><circle cx="17" cy="19" r="1.5"/></svg>
              <b id="pCartN">0</b>
            </button>
          </div>
          <div class="ap-screen" data-tab="0">
            <div class="ap-card">
              <small id="pCardSmall"></small>
              <b id="pCardTitle"></b>
              <button type="button" class="mk-btn" id="pAction"></button>
            </div>
            <div class="ap-sub">Δημοφιλή</div>
            <ul class="ap-list" id="pTop"></ul>
          </div>
          <div class="ap-screen" data-tab="1" hidden>
            <div class="ap-sub" id="pItemsTitle"></div>
            <ul class="ap-list" id="pList"></ul>
          </div>
          <div class="ap-screen" data-tab="2" hidden>
            <div class="ap-sub">Πληροφορίες</div>
            <div class="ap-info"><b>Ωράριο</b><span id="pHours"></span></div>
            <div class="ap-info"><b>Διεύθυνση</b><span>Οδός Παραδείγματος 12</span></div>
          </div>
          <div class="ap-tabs" id="pTabs">
            <button type="button" data-tab-go="0" aria-pressed="true"><i class="t-home"></i>Αρχική</button>
            <button type="button" data-tab-go="1" aria-pressed="false"><i class="t-list"></i><span id="pTabList"></span></button>
            <button type="button" data-tab-go="2" aria-pressed="false"><i class="t-info"></i>Εμείς</button>
          </div>
          <div class="mk-sheet" id="pSheet" inert><div class="sh"></div></div>
          <div class="mk-toast" id="pToast" role="status" aria-live="polite"></div>
        </div>

        <span class="swipe-hint mono" id="swipeHint" aria-hidden="true">‹ σύρε το preview για άλλο ύφος ›</span>

        <div class="sim-cta">
          <button type="button" class="btn btn-p" id="simwant">Θέλω κάτι τέτοιο <span class="k" aria-hidden="true">↗</span></button>
          <span class="mono">Συμπληρώνει τη φόρμα με τις επιλογές σου</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { presets, swatches, styles, icons, type Kind } from '../data/simulator';

  type Mode = 'site' | 'app';
  const state = { kind: 'bakery' as Kind, mode: 'site' as Mode, style: 'modern', color: 'auto', page: 0, tab: 0, flip: false };
  // Λειτουργίες μέσα στο preview: καλάθι, κράτηση, φόρμες
  const cart = new Map<number, number>();
  const booking = { item: -1, day: 0, slot: -1 };
  let sheet: 'cart' | 'book' | 'done' | null = null;
  let doneText = '';

  const $ = (id: string) => document.getElementById(id)!;
  // Φωτογραφίες (public/sim): φορτώνουν μόνο όταν ο simulator πλησιάσει στην οθόνη
  let photosOn = false;
  const ph = (i: number) => `/sim/${state.kind}-${i}.webp`;
  function setImg(el: HTMLImageElement, src: string) {
    if (el.getAttribute('src') === src) return;
    el.classList.remove('ok');
    el.onload = () => el.classList.add('ok');
    el.src = src;
  }
  const mSite = $('mSite');
  const mApp = $('mApp');
  const input = $('biz') as HTMLInputElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Ελληνικά → λατινικά για το domain
  const gr: Record<string, string> = {
    'α':'a','ά':'a','β':'v','γ':'g','δ':'d','ε':'e','έ':'e','ζ':'z','η':'i','ή':'i','θ':'th','ι':'i','ί':'i','ϊ':'i','ΐ':'i',
    'κ':'k','λ':'l','μ':'m','ν':'n','ξ':'x','ο':'o','ό':'o','π':'p','ρ':'r','σ':'s','ς':'s','τ':'t','υ':'y','ύ':'y','ϋ':'y',
    'φ':'f','χ':'ch','ψ':'ps','ω':'o','ώ':'o',
  };
  const slug = (t: string) =>
    t.toLowerCase().split('').map((c) => gr[c] ?? c).join('')
      .replace(/oy/g, 'ou').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'to-site-sou';
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const name = () => input.value.trim() || 'Η επιχείρησή σου';
  const initials = (n: string) => n.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase() || 'P';
  const color = () => (state.color === 'auto' ? presets[state.kind].color : state.color);
  const styleLabel = () => styles.find((s) => s.id === state.style)?.label ?? '';
  const preset = () => presets[state.kind];

  // Κονσόλα
  const logEl = $('log');
  let logTimer: ReturnType<typeof setTimeout>;
  function log(lines: string[]) {
    clearTimeout(logTimer);
    let i = 0;
    const next = () => {
      if (i >= lines.length) return;
      const d = document.createElement('div');
      d.innerHTML = lines[i++];
      logEl.appendChild(d);
      while (logEl.children.length > 7) logEl.firstChild!.remove();
      logTimer = setTimeout(next, 150);
    };
    next();
  }

  // Αλλάζει το HTML μόνο αν όντως άλλαξε, ώστε να μην ξαναπαίζουν τα animations σε κάθε πάτημα πλήκτρου
  function setHTML(el: HTMLElement, html: string) {
    if (el.dataset.h !== html) { el.innerHTML = html; el.dataset.h = html; }
  }

  function showPage(root: HTMLElement, attr: 'page' | 'tab', idx: number) {
    root.querySelectorAll<HTMLElement>(`[data-${attr}]`).forEach((p) => (p.hidden = Number(p.dataset[attr]) !== idx));
  }

  // ---------- Στοιχεία λίστας ----------
  const glyph = (k: Kind) => `<svg viewBox="0 0 24 24" aria-hidden="true">${icons[k]}</svg>`;
  function actionBtn(it: { n: string }, i: number) {
    return preset().flow === 'cart'
      ? `<button type="button" class="mk-add" data-add="${i}" aria-label="Προσθήκη στο καλάθι: ${esc(it.n)}">+</button>`
      : `<button type="button" class="mk-add mk-add-t" data-book="${i}">Κλείσε</button>`;
  }
  function rowHTML(tag: 'div' | 'li', cls: string, it: { n: string; m: string }, i: number) {
    const th = photosOn ? ` ph" style="background-image:url(${ph(1 + (i % 3))})` : '';
    return `<${tag} class="${cls}"><span class="mk-n">${String(i + 1).padStart(2, '0')}</span><span class="mk-thumb${th}">${glyph(state.kind)}</span><div class="mk-it"><b>${esc(it.n)}</b><small>${esc(it.m)}</small></div>${actionBtn(it, i)}</${tag}>`;
  }

  // ---------- Φύλλα (καλάθι / κράτηση) ----------
  const slots = ['09:00', '10:30', '12:00', '17:00', '18:30', '20:00'];
  const dayLabels = () =>
    Array.from({ length: 5 }, (_, i) => {
      const d = new Date();
      d.setDate(d.getDate() + i + 1);
      return d.toLocaleDateString('el-GR', { weekday: 'short', day: 'numeric' });
    });
  // «πιασμένες» ώρες, πάντα ίδιες για τον ίδιο κλάδο ώστε να φαίνεται ρεαλιστικό
  const taken = (d: number, s: number) => (d * 7 + s * 3 + state.kind.length) % 4 === 0;
  const cartCount = () => [...cart.values()].reduce((a, b) => a + b, 0);

  function sheetHTML(): string {
    const p = preset();
    const head = (t: string) => `<div class="sh-head"><b>${esc(t)}</b><button type="button" class="sh-x" data-sheet-close aria-label="Κλείσιμο">×</button></div>`;
    if (sheet === 'done') {
      return `${head('')}<div class="sh-done"><span class="sh-ok"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><b>${esc(doneText)}</b><small>Είναι demo, δεν στάλθηκε τίποτα.</small><button type="button" class="mk-btn" data-sheet-close>Εντάξει</button></div>`;
    }
    if (sheet === 'cart') {
      const rows = [...cart.entries()].map(([i, q]) =>
        `<div class="sh-row"><span>${esc(p.items[i].n)}</span><span class="sh-qty"><button type="button" data-qty="${i}" data-d="-1" aria-label="Λιγότερα">−</button><b>${q}</b><button type="button" data-qty="${i}" data-d="1" aria-label="Περισσότερα">+</button></span></div>`).join('');
      return `${head('Καλάθι')}${rows || '<p class="sh-empty">Το καλάθι είναι άδειο. Πρόσθεσε κάτι με το «+».</p>'}<button type="button" class="mk-btn sh-go" data-checkout ${cart.size ? '' : 'disabled'}>Ολοκλήρωση παραγγελίας</button>`;
    }
    if (sheet === 'book') {
      const days = dayLabels().map((l, i) => `<button type="button" class="chip" data-day="${i}" aria-pressed="${i === booking.day}">${esc(l)}</button>`).join('');
      const sl = slots.map((t, i) => {
        const off = taken(booking.day, i);
        return `<button type="button" class="chip" data-slot="${i}" aria-pressed="${i === booking.slot}" ${off ? 'disabled title="Δεν υπάρχει διαθεσιμότητα"' : ''}>${t}</button>`;
      }).join('');
      const it = booking.item >= 0 ? `<p class="sh-item">${esc(p.items[booking.item].n)}</p>` : '';
      return `${head(p.bookTitle)}${it}<div class="sh-lbl">Ημέρα</div><div class="sh-chips">${days}</div><div class="sh-lbl">Ώρα</div><div class="sh-chips">${sl}</div><button type="button" class="mk-btn sh-go" data-confirm ${booking.slot < 0 ? 'disabled' : ''}>Επιβεβαίωση</button>`;
    }
    return '';
  }

  function syncSheet() {
    const html = sheetHTML();
    for (const id of ['sSheet', 'pSheet']) {
      const el = $(id);
      if (sheet) setHTML(el.firstElementChild as HTMLElement, html);
      el.classList.toggle('open', !!sheet);
      el.toggleAttribute('inert', !sheet);
    }
  }

  function updateBadges() {
    const n = cartCount();
    const show = preset().flow === 'cart';
    for (const [btn, num] of [['sCartBtn', 'sCartN'], ['pCartBtn', 'pCartN']]) {
      ($(btn) as HTMLElement).hidden = !show;
      $(num).textContent = String(n);
      $(btn).classList.toggle('has', n > 0);
    }
  }

  let toastTimer: ReturnType<typeof setTimeout>;
  function toast(text: string) {
    for (const id of ['sToast', 'pToast']) { $(id).textContent = text; $(id).classList.add('on'); }
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => ['sToast', 'pToast'].forEach((id) => $(id).classList.remove('on')), 1700);
  }

  function resetFlow() {
    cart.clear();
    booking.item = -1; booking.day = 0; booking.slot = -1;
    sheet = null;
  }

  // ---------- Ζωγραφίζει όλο το preview ----------
  let swapTimer: ReturnType<typeof setTimeout>;
  // Πάνω δεξιά: σύντομο «compiling → ready» σε κάθε αλλαγή
  const resText = () => (state.mode === 'site' ? '1440 × 900' : '390 × 844');
  let statusUntil = 0;
  let statusTimers: ReturnType<typeof setTimeout>[] = [];
  function buildStatus() {
    const res = $('res');
    statusTimers.forEach(clearTimeout);
    statusUntil = performance.now() + 1900;
    res.className = 'corner mono busy';
    res.textContent = 'compiling…';
    statusTimers = [
      setTimeout(() => { res.className = 'corner mono done'; res.textContent = `✓ ready ${(0.18 + Math.random() * 0.3).toFixed(2)}s`; }, 520),
      setTimeout(() => { res.className = 'corner mono'; res.textContent = resText(); }, 1900),
    ];
  }
  // Ομαλή αλλαγή: σβήνει σιγά-σιγά το παλιό, γεμίζει το νέο και το «φέρνει» μέσα με animation
  function render(opts: { log?: boolean; flash?: boolean } = {}) {
    if (!opts.flash || reduce) return paint(opts);
    buildStatus();
    const el = state.mode === 'site' ? mSite : mApp;
    const other = state.mode === 'site' ? mApp : mSite;
    clearTimeout(swapTimer);
    const leaving = [mSite, mApp].find((m) => !m.classList.contains('hide'));
    (leaving ?? el).classList.add('out');
    swapTimer = setTimeout(() => {
      [mSite, mApp].forEach((m) => m.classList.remove('out', 'in'));
      paint(opts);
      void el.offsetWidth;
      el.classList.add('in', 'build');
      setTimeout(() => el.classList.remove('build'), 1000);
      other.classList.remove('in');
      setTimeout(() => el.classList.remove('in'), 600);
    }, 190);
  }

  function paint(opts: { log?: boolean } = {}) {
    const p = preset();
    const n = name();
    const c = color();
    const ini = initials(n);
    const cartKind = p.flow === 'cart';

    for (const m of [mSite, mApp]) {
      m.style.setProperty('--k', c);
      m.dataset.style = state.style;
      // το «Τολμηρό» είναι από φύση σκούρο, οπότε εκεί το κουμπί δίνει φωτεινό
      const dark = state.style === 'bold' || state.style === 'neon' ? !state.flip : state.flip;
      m.dataset.mode = dark ? 'dark' : 'light';
    }

    // Φωτογραφίες
    if (photosOn) {
      setImg($('sPh') as HTMLImageElement, ph(0));
      for (const m of [mSite, mApp]) {
        m.classList.add('photos');
        m.style.setProperty('--ph', `url(${ph(0)})`);
        m.style.setProperty('--ph3', `url(${ph(3)})`);
      }
    }
    setHTML($('sGal'), photosOn
      ? [1, 2, 3].map((i, n) => `<figure><img src="${ph(i)}" alt="" loading="lazy" decoding="async" onload="this.classList.add('ok')"><figcaption>${esc(p.features[n] ?? '')}</figcaption></figure>`).join('')
      : '');

    // Ιστοσελίδα
    $('url').textContent = slug(n) + '.gr';
    $('sName').textContent = n;
    $('sMark').textContent = ini;
    $('sHead').textContent = p.headline;
    $('sSub').textContent = p.sub;
    $('sItemsTitle').textContent = p.itemsTitle;
    $('sPopTitle').textContent = cartKind ? 'Δημοφιλή' : p.itemsTitle;
    $('sHours').textContent = p.hours;
    $('sFoot').textContent = `© ${n}`;
    $('sGlyph').innerHTML = icons[state.kind];
    $('sKicker').textContent = p.label;
    $('sHoursMini').textContent = p.hours;
    $('sChip1').innerHTML = `<i></i>${esc(p.items[0].m)} · ${esc(p.items[0].n)}`;
    $('sChip2').textContent = p.hours;
    const rep = p.features.map(esc).join(' ✦ ') + ' ✦ ';
    setHTML($('sMarq'), `<span>${rep.repeat(3)}</span><span>${rep.repeat(3)}</span>`);

    // Το κύριο κουμπί: στο καλάθι/κατάλογο ή σε κράτηση
    for (const [id, label] of [['sCta', p.cta], ['sBandB', p.cta]] as const) {
      const b = $(id);
      b.textContent = label;
      if (cartKind) { b.setAttribute('data-go', '1'); b.removeAttribute('data-book'); }
      else { b.removeAttribute('data-go'); b.setAttribute('data-book', '-1'); }
    }
    $('sBandT').textContent = cartKind ? 'Παράγγειλε online σε λίγα λεπτά.' : 'Κλείσε online σε λίγα λεπτά.';

    const navLabels = ['Αρχική', p.itemsTitle, 'Επικοινωνία'];
    setHTML($('sNav'), navLabels
      .map((l, i) => `<button type="button" data-go="${i}" aria-pressed="${i === state.page}">${esc(l)}</button>`)
      .join(''));
    setHTML($('sFeats'), p.features.map((f) => `<div><i></i>${esc(f)}</div>`).join(''));
    setHTML($('sPop'), p.items.slice(0, 4).map((it, i) => rowHTML('div', 'mk-item', it, i)).join(''));
    setHTML($('sItems'), p.items.map((it, i) => rowHTML('div', 'mk-item', it, i)).join(''));
    showPage(mSite, 'page', state.page);

    // Εφαρμογή
    $('pMark').textContent = ini;
    $('pName').textContent = n;
    $('pHi').textContent = p.greeting;
    $('pCardSmall').textContent = p.hours;
    $('pCardTitle').textContent = p.headline;
    const act = $('pAction');
    act.textContent = p.appAction;
    if (cartKind) { act.setAttribute('data-tab-go', '1'); act.removeAttribute('data-book'); }
    else { act.removeAttribute('data-tab-go'); act.setAttribute('data-book', '-1'); }
    $('pItemsTitle').textContent = p.itemsTitle;
    $('pTabList').textContent = p.itemsTitle;
    $('pHours').textContent = p.hours;
    setHTML($('pTop'), p.items.slice(0, 3).map((it, i) => rowHTML('li', '', it, i)).join(''));
    setHTML($('pList'), p.items.map((it, i) => rowHTML('li', '', it, i)).join(''));
    $('pTabs').querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.tabGo) === state.tab)));
    showPage(mApp, 'tab', state.tab);

    mSite.classList.toggle('hide', state.mode !== 'site');
    mApp.classList.toggle('hide', state.mode !== 'app');
    if (performance.now() > statusUntil) $('res').textContent = resText();
    updateBadges();
    syncSheet();

    if (opts.log !== false) {
      log([
        `&gt; build <span class="hl">${esc(slug(n))}</span> --${state.mode}`,
        `&gt; layout ${state.kind} · style ${state.style}`,
        `&gt; theme ${c}`,
        '&gt; compiling components…',
        `<span class="ok">✓ ready in ${(0.25 + Math.random() * 0.5).toFixed(2)}s</span>`,
      ]);
    }
  }

  // Ομάδες κουμπιών (κλάδος, τύπος, ύφος)
  function group(id: string, onPick: (b: HTMLButtonElement) => void) {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>(`#${id} > button`)];
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        onPick(b);
        render({ flash: true });
      }),
    );
    return buttons;
  }
  const kindBtns = group('kinds', (b) => { state.kind = b.dataset.k as Kind; state.page = 0; state.tab = 0; resetFlow(); });
  group('mode', (b) => { state.mode = b.dataset.m as Mode; sheet = null; });
  const styleBtns = group('styles', (b) => { state.style = b.dataset.s!; });

  // Χρώματα
  const swBtns = [...document.querySelectorAll<HTMLButtonElement>('#swatches > button')];
  const custom = $('swcustom') as HTMLInputElement;
  const customLabel = custom.parentElement!;
  function pickColor(c: string, fromCustom = false) {
    state.color = c;
    swBtns.forEach((x) => x.setAttribute('aria-pressed', String(!fromCustom && x.dataset.c === c)));
    customLabel.classList.toggle('on', fromCustom);
    if (fromCustom) customLabel.style.setProperty('--sw', c);
  }
  swBtns.forEach((b) => b.addEventListener('click', () => { pickColor(b.dataset.c!); render(); }));
  custom.addEventListener('input', () => { pickColor(custom.value, true); render({ log: false }); });
  custom.addEventListener('change', () => render());

  // Dark / Light
  const flipBtn = $('simflip');
  flipBtn.addEventListener('click', () => {
    state.flip = !state.flip;
    flipBtn.setAttribute('aria-pressed', String(state.flip));
    paint({ log: false });
    log([`&gt; theme --${mSite.dataset.mode}`, '<span class="ok">✓ applied</span>']);
  });

  // ---------- Αλληλεπίδραση μέσα στα mockups ----------
  function onAction(e: Event) {
    const t = e.target as HTMLElement;
    const p = preset();
    const q = <T extends HTMLElement = HTMLElement>(sel: string) => t.closest<T>(sel);
    let el: HTMLElement | null;

    if (t.classList.contains('mk-sheet') || q('[data-sheet-close]')) { sheet = null; syncSheet(); return; }

    if ((el = q('[data-go]'))) {
      state.page = Number(el.dataset.go);
      paint({ log: false });
      $('sBody').scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      return;
    }
    if ((el = q('[data-tab-go]'))) { state.tab = Number(el.dataset.tabGo); paint({ log: false }); return; }

    if ((el = q('[data-add]'))) {
      const i = Number(el.dataset.add);
      cart.set(i, (cart.get(i) ?? 0) + 1);
      updateBadges();
      toast(`Προστέθηκε: ${p.items[i].n}`);
      log([`&gt; cart.add <span class="hl">"${esc(p.items[i].n)}"</span>`, `<span class="ok">✓ ${cartCount()} προϊόντα στο καλάθι</span>`]);
      return;
    }
    if ((el = q('[data-book]'))) {
      booking.item = Number(el.dataset.book);
      booking.day = 0;
      booking.slot = -1;
      sheet = 'book';
      syncSheet();
      log(['&gt; booking.open', '&gt; διαθεσιμότητα: ok']);
      return;
    }
    if (q('[data-cart-open]')) { sheet = 'cart'; syncSheet(); return; }

    if ((el = q('[data-qty]'))) {
      const i = Number(el.dataset.qty);
      const next = (cart.get(i) ?? 0) + Number(el.dataset.d);
      if (next <= 0) cart.delete(i); else cart.set(i, next);
      updateBadges();
      syncSheet();
      return;
    }
    if ((el = q('[data-day]'))) { booking.day = Number(el.dataset.day); booking.slot = -1; syncSheet(); return; }
    if ((el = q('[data-slot]'))) { booking.slot = Number(el.dataset.slot); syncSheet(); return; }

    if (q('[data-confirm]')) {
      doneText = p.bookOk;
      sheet = 'done';
      booking.slot = -1;
      syncSheet();
      log(['&gt; booking.confirm', `<span class="ok">✓ ${esc(p.bookOk)}</span>`]);
      return;
    }
    if (q('[data-checkout]')) {
      doneText = 'Η παραγγελία στάλθηκε';
      sheet = 'done';
      cart.clear();
      updateBadges();
      syncSheet();
      log(['&gt; order.create', '<span class="ok">✓ η παραγγελία στάλθηκε</span>']);
    }
  }
  // Κινητό: καρτέλες στο dock και το preview να μένει πάντα στην οθόνη
  const ctrl = $('simctrl');
  const mobile = matchMedia('(max-width: 1000px)');
  ctrl.querySelectorAll<HTMLButtonElement>('.ctabs [data-g]').forEach((t) =>
    t.addEventListener('click', () => {
      ctrl.querySelectorAll<HTMLButtonElement>('.ctabs [data-g]').forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      ctrl.querySelectorAll<HTMLElement>('.cg').forEach((g) => g.classList.toggle('on', g.dataset.g === t.dataset.g));
      t.scrollIntoView({ block: 'nearest', inline: 'center', behavior: reduce ? 'auto' : 'smooth' });
    }));
  ctrl.addEventListener('click', (e) => {
    if (!e.isTrusted || !mobile.matches || !(e.target as HTMLElement).closest('.cg button, .cg .sw')) return;
    const view = ctrl.parentElement!.querySelector<HTMLElement>('.view')!;
    const top = view.getBoundingClientRect().top;
    if (top < -24 || top > 140) {
      scrollTo({ top: scrollY + top - 8, behavior: reduce ? 'auto' : 'smooth' });
    }
  });

  // ---------- Swipe στο κινητό: αλλάζει ύφος ----------
  const simEl = ctrl.parentElement!;
  const viewEl = simEl.querySelector<HTMLElement>('.view')!;
  let sx = 0, sy = 0;
  viewEl.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
  viewEl.addEventListener('touchend', (e) => {
    const t = e.changedTouches[0];
    const dx = t.clientX - sx, dy = t.clientY - sy;
    if (Math.abs(dx) < 60 || Math.abs(dx) < Math.abs(dy) * 1.6) return;
    const i = styleBtns.findIndex((b) => b.dataset.s === state.style);
    styleBtns[(i + (dx < 0 ? 1 : -1) + styleBtns.length) % styleBtns.length].click();
    $('swipeHint').classList.add('gone');
  }, { passive: true });

  // ---------- Αυτόματη επίδειξη: ένα «χέρι» δοκιμάζει το site μόνο του ----------
  const ghost = document.createElement('div');
  ghost.className = 'ghost';
  ghost.setAttribute('aria-hidden', 'true');
  ghost.innerHTML = '<svg viewBox="0 0 24 24"><path d="M4 2.5l15 9-6.6 1.7L9 20z"/></svg>';
  document.body.appendChild(ghost);
  const pill = $('autoPill');
  class Stop extends Error {}
  let autoRun = 0;
  let userTook = false;
  const auto = () => simEl.classList.contains('auto');
  const wait = (ms: number, id: number) =>
    new Promise<void>((res, rej) => setTimeout(() => (id === autoRun ? res() : rej(new Stop())), ms));
  const inMock = (sel: string) => (state.mode === 'site' ? mSite : mApp).querySelector<HTMLElement>(sel);

  async function point(el: HTMLElement | null, id: number) {
    if (!el) return;
    const body = el.closest<HTMLElement>('.mk-body');
    if (body) {
      const br = body.getBoundingClientRect(), r = el.getBoundingClientRect();
      if (r.top < br.top + 10 || r.bottom > br.bottom - 10) {
        body.scrollTo({ top: body.scrollTop + r.top - br.top - 70, behavior: 'smooth' });
        await wait(600, id);
      }
    }
    const r = el.getBoundingClientRect();
    if (!r.width || r.top < 0 || r.bottom > innerHeight) { ghost.classList.remove('on'); return; }
    ghost.classList.add('on');
    ghost.style.transform = `translate(${r.left + r.width * 0.5}px, ${r.top + r.height * 0.55}px)`;
    await wait(820, id);
  }
  async function tap(el: HTMLElement | null, id: number, after = 700) {
    if (!el) return;
    await point(el, id);
    ghost.classList.remove('press');
    void ghost.offsetWidth;
    ghost.classList.add('press');
    el.click();
    await wait(after, id);
  }
  async function control(g: string, sel: string, id: number) {
    const el = ctrl.querySelector<HTMLElement>(sel);
    if (!el || el.getAttribute('aria-pressed') === 'true') return;
    if (mobile.matches) {
      const t = ctrl.querySelector<HTMLElement>(`.ctabs [data-g="${g}"]`);
      if (t && t.getAttribute('aria-selected') !== 'true') await tap(t, id, 380);
    }
    await tap(el, id, 1150);
  }
  async function typeName(text: string, id: number) {
    if (input.value === text) return;
    if (mobile.matches) await tap(ctrl.querySelector<HTMLElement>('.ctabs [data-g="name"]'), id, 300);
    await point(input, id);
    input.value = '';
    for (const ch of text) {
      input.value += ch;
      input.dispatchEvent(new Event('input'));
      await wait(75, id);
    }
    await wait(800, id);
  }
  async function book(sheetSel: string, id: number) {
    await tap(inMock(`${sheetSel} [data-day="1"]`), id, 550);
    await tap(inMock(`${sheetSel} [data-slot]:not(:disabled)`), id, 550);
    await tap(inMock(`${sheetSel} [data-confirm]`), id, 1600);
    await tap(inMock(`${sheetSel} .sh-done [data-sheet-close]`), id, 700);
  }

  const scenes: ((id: number) => Promise<void>)[] = [
    // Φούρνος: e-shop με καλάθι
    async (id) => {
      await control('mode', '#mode [data-m="site"]', id);
      await control('kind', '#kinds [data-k="bakery"]', id);
      await typeName('Φούρνος Ελένη', id);
      await control('style', '#styles [data-s="modern"]', id);
      await tap(inMock('#sNav [data-go="1"]'), id, 900);
      await tap(inMock('#sItems [data-add="0"]'), id, 650);
      await tap(inMock('#sItems [data-add="2"]'), id, 650);
      await tap(inMock('#sCartBtn'), id, 1000);
      await tap(inMock('#sSheet [data-checkout]'), id, 1600);
      await tap(inMock('#sSheet .sh-done [data-sheet-close]'), id, 700);
    },
    // Γυμναστήριο: κράτηση θέσης, τολμηρό ύφος
    async (id) => {
      await control('kind', '#kinds [data-k="gym"]', id);
      await control('style', '#styles [data-s="bold"]', id);
      await tap(inMock('#sCta'), id, 900);
      await book('#sSheet', id);
    },
    // Κομμωτήριο: εφαρμογή, κομψό ύφος, δικό του όνομα και χρώμα
    async (id) => {
      await control('kind', '#kinds [data-k="beauty"]', id);
      await typeName('Studio Μαρία', id);
      await control('style', '#styles [data-s="elegant"]', id);
      await control('color', '#swatches [data-c="#B5477A"]', id);
      await control('mode', '#mode [data-m="app"]', id);
      await tap(inMock('#pTabs [data-tab-go="1"]'), id, 800);
      await tap(inMock('#pList [data-book="1"]'), id, 900);
      await book('#pSheet', id);
      await tap(inMock('#pTabs [data-tab-go="0"]'), id, 700);
    },
    // Ξενοδοχείο: νέον ύφος και βόλτα στη σελίδα
    async (id) => {
      await control('mode', '#mode [data-m="site"]', id);
      await control('kind', '#kinds [data-k="hotel"]', id);
      await control('color', '#swatches [data-c="auto"]', id);
      await control('style', '#styles [data-s="neon"]', id);
      await typeName('Aegean Suites', id);
      ghost.classList.remove('on');
      const body = $('sBody');
      body.scrollTo({ top: 520, behavior: 'smooth' });
      await wait(1900, id);
      body.scrollTo({ top: 0, behavior: 'smooth' });
      await wait(1300, id);
    },
  ];

  function endAuto() {
    autoRun++;
    ghost.classList.remove('on', 'press');
    pill.hidden = true;
    simEl.classList.remove('auto');
  }
  async function autopilot() {
    if (auto()) return;
    const id = ++autoRun;
    pill.hidden = false;
    simEl.classList.add('auto');
    log(['&gt; autopilot --demo', '<span class="ok">✓ ξεκίνησε</span>']);
    try {
      for (let loop = 0; loop < 3; loop++) for (const scene of scenes) await scene(id);
    } catch (e) {
      if (!(e instanceof Stop)) throw e;
    }
    if (id === autoRun) endAuto();
  }
  // Με το πρώτο πραγματικό άγγιγμα ο έλεγχος περνά στον επισκέπτη
  simEl.addEventListener('pointerdown', (e) => {
    if (e.isTrusted && auto()) { userTook = true; endAuto(); }
  }, true);
  addEventListener('keydown', () => { if (auto()) { userTook = true; endAuto(); } });
  addEventListener('scroll', () => ghost.classList.remove('on'), { passive: true });
  $('simauto').addEventListener('click', () => { userTook = false; setTimeout(autopilot, 250); });
  // Ξεκινά μόνο του όταν το preview φανεί στην οθόνη (και σταματά όταν φύγει)
  let startTimer: ReturnType<typeof setTimeout>;
  if (!reduce && 'IntersectionObserver' in window) {
    new IntersectionObserver(([en]) => {
      const visible = en.isIntersecting && en.intersectionRatio >= 0.35;
      clearTimeout(startTimer);
      if (visible && !userTook && !auto()) startTimer = setTimeout(autopilot, 1400);
      if (!visible && auto()) endAuto();
    }, { threshold: [0, 0.35, 0.6] }).observe(viewEl);
  }

  mSite.addEventListener('click', onAction);
  mApp.addEventListener('click', onAction);
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && sheet) { sheet = null; syncSheet(); } });

  // Φόρμα επικοινωνίας του demo
  $('sForm').addEventListener('submit', (e) => {
    e.preventDefault();
    $('sFormOk').hidden = false;
    log(['&gt; form.submit', '<span class="ok">✓ received</span>']);
  });

  // Όνομα
  let debounce: ReturnType<typeof setTimeout>;
  input.addEventListener('input', () => {
    render({ log: false });
    clearTimeout(debounce);
    debounce = setTimeout(() => render(), 500);
  });

  // Έκπληξη: τυχαίος κλάδος, ύφος και χρώμα
  const pick = <T,>(a: T[]) => a[(Math.random() * a.length) | 0];
  $('simrandom').addEventListener('click', () => {
    const kb = pick(kindBtns.filter((b) => b.dataset.k !== state.kind));
    const sb = pick(styleBtns);
    kindBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === kb)));
    styleBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === sb)));
    state.kind = kb.dataset.k as Kind;
    state.style = sb.dataset.s!;
    state.page = 0;
    state.tab = 0;
    resetFlow();
    pickColor(pick(swatches));
    render({ flash: true });
  });

  // «Θέλω κάτι τέτοιο»: συμπληρώνει τη φόρμα επικοινωνίας και πηγαίνει εκεί
  $('simwant').addEventListener('click', () => {
    const msg = document.getElementById('cf-msg') as HTMLTextAreaElement | null;
    const what = state.mode === 'site' ? 'ιστοσελίδα' : 'εφαρμογή';
    const text =
      `Γεια σας! Θα ήθελα ${what} για «${name()}» (${preset().label}).\n` +
      `Από το simulator μου άρεσε το ύφος «${styleLabel()}» με χρώμα ${color()}.`;
    if (msg) msg.value = text;
    document.getElementById('contact')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
    setTimeout(() => (document.getElementById('cf-name') as HTMLInputElement | null)?.focus({ preventScroll: true }), reduce ? 0 : 700);
  });

  paint();
  if ('IntersectionObserver' in window) {
    new IntersectionObserver((ens, obs) => {
      if (!ens.some((e) => e.isIntersecting)) return;
      obs.disconnect();
      photosOn = true;
      paint({ log: false });
      // οι υπόλοιποι κλάδοι φορτώνουν στο παρασκήνιο για άμεση εναλλαγή
      setTimeout(() => (Object.keys(presets) as Kind[]).forEach((k) => { new Image().src = `/sim/${k}-0.webp`; }), 2500);
    }, { rootMargin: '900px 0px' }).observe(simEl);
  } else { photosOn = true; paint({ log: false }); }
</script>
