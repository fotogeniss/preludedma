---
import { presets, swatches, styles, type Kind } from '../data/simulator';
const kinds = Object.entries(presets) as [Kind, (typeof presets)[Kind]][];
---
<section class="s" id="lab" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="mono"><b>[ SYS.02 ]</b> Simulator</span>
        <h2 class="h2">Δες το δικό σου<br /><span class="ol">πριν υπάρξει</span></h2>
      </div>
      <p>Γράψε το όνομα της επιχείρησής σου, διάλεξε κλάδο, ύφος και χρώμα, και δες ένα πρώτο σκίτσο του site ή της εφαρμογής σου. Πάτα και τα μενού μέσα στο preview.</p>
    </div>

    <div class="sim-note" role="note">
      <span class="sim-badge mono">Demo</span>
      <p>Ένα δείγμα για να δεις πώς δουλεύουμε. Το δικό σου project σχεδιάζεται από το μηδέν, μαζί σου.</p>
    </div>

    <div class="sim">
      <div class="ctrl" id="simctrl">
        <div class="ctabs" role="tablist" aria-label="Ρυθμίσεις preview">
          <button type="button" role="tab" data-g="kind" aria-selected="true">Κλάδος</button>
          <button type="button" role="tab" data-g="mode" aria-selected="false">Τύπος</button>
          <button type="button" role="tab" data-g="style" aria-selected="false">Ύφος</button>
          <button type="button" role="tab" data-g="brand" aria-selected="false">Λογότυπο</button>
          <button type="button" role="tab" data-g="font" aria-selected="false">Font & γωνίες</button>
          <button type="button" role="tab" data-g="blocks" aria-selected="false">Ενότητες</button>
          <button type="button" role="tab" data-g="color" aria-selected="false">Χρώμα</button>
          <button type="button" role="tab" data-g="name" aria-selected="false">Όνομα</button>
          <button type="button" role="tab" data-g="spec" aria-selected="false">Εκτίμηση</button>
          <button type="button" role="tab" data-g="extra" aria-selected="false">Extra</button>
        </div>
        <div class="cg" data-g="name">
          <label for="biz">Input // όνομα επιχείρησης</label>
          <input id="biz" value={presets.bakery.demo} maxlength="26" autocomplete="off" placeholder="π.χ. Φούρνος Ελένη" />
        </div>

        <div class="cg on" data-g="kind">
          <span class="lbl" id="lbl-kind">Input // κλάδος</span>
          <div class="opts" id="kinds" role="group" aria-labelledby="lbl-kind">
            {kinds.map(([key, p], i) => (
              <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-k={key}>{p.label}</button>
            ))}
          </div>
        </div>

        <div class="ctrl-row cg" data-g="mode">
          <div>
            <span class="lbl" id="lbl-mode">Output // τύπος</span>
            <div class="opts" id="mode" role="group" aria-labelledby="lbl-mode">
              <button type="button" aria-pressed="true" data-m="site">Ιστοσελίδα</button>
              <button type="button" aria-pressed="false" data-m="app">Εφαρμογή</button>
              <button type="button" aria-pressed="false" data-m="admin" class="span2">Διαχείριση (ιδιοκτήτης)</button>
            </div>
          </div>
        </div>

        <div class="cg" data-g="style">
          <span class="lbl" id="lbl-style">Input // ύφος</span>
          <div class="opts" id="styles" role="group" aria-labelledby="lbl-style">
            {styles.map((s, i) => (
              <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-s={s.id}>{s.label}</button>
            ))}
          </div>
        </div>

        <div class="cg" data-g="brand">
          <span class="lbl" id="lbl-brand">Input // το λογότυπο & η φωτογραφία σου</span>
          <div class="brand-ups" role="group" aria-labelledby="lbl-brand">
            <label class="up-btn" id="upLogoL"><input type="file" id="upLogo" accept="image/*" /><span id="upLogoT">＋ Λογότυπο</span></label>
            <label class="up-btn" id="upPhotoL"><input type="file" id="upPhoto" accept="image/*" /><span id="upPhotoT">＋ Φωτογραφία</span></label>
            <button type="button" class="up-clear" id="upClear" hidden>Αφαίρεση</button>
          </div>
          <small class="up-note">Μένουν μόνο στον browser σου, δεν ανεβαίνουν πουθενά. Το χρώμα του site παίρνεται από το λογότυπο.</small>
        </div>

        <div class="cg" data-g="font">
          <span class="lbl sub" id="lbl-font">Input // γραμματοσειρά</span>
          <div class="opts chips" id="fonts" role="group" aria-labelledby="lbl-font">
            <button type="button" aria-pressed="true" data-f="auto">Του ύφους</button>
            <button type="button" aria-pressed="false" data-f="sans">Sans</button>
            <button type="button" aria-pressed="false" data-f="serif">Serif</button>
            <button type="button" aria-pressed="false" data-f="tech">Tech</button>
            <button type="button" aria-pressed="false" data-f="mono">Mono</button>
          </div>
          <span class="lbl sub" id="lbl-corner">Input // γωνίες</span>
          <div class="opts chips" id="corners" role="group" aria-labelledby="lbl-corner">
            <button type="button" aria-pressed="true" data-r="auto">Του ύφους</button>
            <button type="button" aria-pressed="false" data-r="square">Ίσιες</button>
            <button type="button" aria-pressed="false" data-r="round">Στρογγυλές</button>
            <button type="button" aria-pressed="false" data-r="pill">Πολύ στρογγυλές</button>
          </div>
        </div>

        <div class="cg" data-g="blocks">
          <span class="lbl" id="lbl-blocks">Input // ενότητες της σελίδας</span>
          <div class="blk-ctl" id="blkCtl" role="group" aria-labelledby="lbl-blocks"></div>
        </div>

        <div class="cg" data-g="spec">
          <span class="lbl">Output // εκτίμηση</span>
          <div class="spec-box" id="specBox" aria-live="polite"></div>
        </div>

        <div class="cg" data-g="color">
          <span class="lbl" id="lbl-color">Input // χρώμα</span>
          <div class="swatches" id="swatches" role="group" aria-labelledby="lbl-color">
            {swatches.map((c, i) => (
              <button
                type="button"
                class:list={['sw', { auto: c === 'auto' }]}
                aria-pressed={i === 0 ? 'true' : 'false'}
                data-c={c}
                style={c === 'auto' ? undefined : `--sw:${c}`}
                aria-label={c === 'auto' ? 'Χρώμα του κλάδου' : `Χρώμα ${c}`}
                title={c === 'auto' ? 'Του κλάδου' : c}
              ></button>
            ))}
            <label class="sw sw-custom" title="Δικό σου χρώμα">
              <input type="color" id="swcustom" value="#7B3FE4" aria-label="Διάλεξε δικό σου χρώμα" />
            </label>
          </div>
        </div>

        <div class="sim-btns cg" data-g="extra">
          <button type="button" class="btn btn-g sim-random" id="simrandom">Έκπληξη <span class="k" aria-hidden="true">⟳</span></button>
          <button type="button" class="btn btn-g sim-random" id="simflip" aria-pressed="false">Dark / Light <span class="k" aria-hidden="true">◐</span></button>
          <button type="button" class="btn btn-g sim-random" id="simauto">Auto demo <span class="k" aria-hidden="true">▶</span></button>
          <button type="button" class="btn btn-g sim-random" id="simshare">Link σχεδίου <span class="k" aria-hidden="true">⧉</span></button>
          <button type="button" class="btn btn-g sim-random" id="simbot" aria-pressed="true">AI chatbot <span class="k" aria-hidden="true">✦</span></button>
        </div>

        <div class="sim-console">
          <span class="lbl">Console</span>
          <div class="log" id="log" aria-live="polite"></div>
        </div>
      </div>

      <div class="view">
        <span class="corner mono" style="top:18px;left:22px">Preview // live</span>
        <span class="corner mono" style="bottom:16px;right:22px" id="res">1440 × 900</span>
        <div class="vw-tools" role="group" aria-label="Εργαλεία preview">
          <button type="button" id="simUndo" title="Αναίρεση (Ctrl+Z)" aria-label="Αναίρεση" disabled>↶</button>
          <button type="button" id="simRedo" title="Επανάληψη (Ctrl+Y)" aria-label="Επανάληψη" disabled>↷</button>
          <button type="button" id="simFs" title="Πλήρης οθόνη" aria-label="Πλήρης οθόνη" aria-pressed="false"><span class="fs-on">⤢</span><span class="fs-off">✕</span></button>
        </div>
        <div class="dev-sw" id="devSw" role="group" aria-label="Συσκευή">
          <button type="button" data-dev="desktop" aria-pressed="true" title="Desktop" aria-label="Desktop"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="1.5"/><path d="M8 20h8M12 16v4"/></svg></button>
          <button type="button" data-dev="tablet" aria-pressed="false" title="Tablet" aria-label="Tablet"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M11 18h2"/></svg></button>
          <button type="button" data-dev="phone" aria-pressed="false" title="Κινητό" aria-label="Κινητό"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7.5" y="3" width="9" height="18" rx="2"/><path d="M11 18h2"/></svg></button>
        </div>
        <button type="button" class="own-note" id="ownNote" hidden><i></i><span id="ownNoteT"></span><b>Δες τι βλέπει ο ιδιοκτήτης →</b></button>
        <button type="button" class="auto-pill mono" id="autoPill" hidden><i></i>Auto demo · πάτα για να το δοκιμάσεις</button>
        <span class="corner mono demo-mark" style="bottom:16px;left:22px">Demo · ενδεικτικό σκίτσο</span>

        <!-- Ιστοσελίδα -->
        <div class="mock mock-site" id="mSite" data-style="modern">
          <div class="mk-url"><i></i><i></i><i></i><span id="url"></span></div>
          <div class="mk-nav">
            <span class="mk-brand"><span class="mk-mark" id="sMark"></span><b id="sName"></b></span>
            <nav class="mk-links" id="sNav"></nav>
            <button type="button" class="mk-lang" data-lang-toggle title="Ελληνικά / English" aria-label="Αλλαγή γλώσσας"><b class="l-el">EL</b><span>/</span><b class="l-en">EN</b></button>
            <button type="button" class="mk-cart" id="sCartBtn" data-cart-open aria-label="Καλάθι" hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2 11h11l2-8H6"/><circle cx="9" cy="19" r="1.5"/><circle cx="17" cy="19" r="1.5"/></svg>
              <b id="sCartN">0</b>
            </button>
          </div>
          <div class="mk-body" id="sBody">
            <div class="mk-page" data-page="0">
              <div class="mk-hero">
                <div class="blk-bar hero-bar"><span>Hero</span><button type="button" data-hero-cycle title="Άλλαξε διάταξη">⇄</button></div>
                <div class="mk-copy">
                  <span class="mk-kicker" id="sKicker" data-ed="k" contenteditable="true" spellcheck="false"></span>
                  <div class="mk-h" id="sHead" data-ed="h" contenteditable="true" spellcheck="false" title="Γράψε τον δικό σου τίτλο"></div>
                  <p class="mk-sub" id="sSub" data-ed="s" contenteditable="true" spellcheck="false" title="Γράψε τη δική σου περιγραφή"></p>
                  <div class="mk-ctas">
                    <button type="button" class="mk-btn" id="sCta"></button>
                    <span class="mk-hrs" id="sHoursMini"></span>
                  </div>
                  <div class="mk-search" id="sSearch"></div>
                </div>
                <div class="mk-pic">
                  <i class="art-a"></i><img class="art-ph" id="sPh" alt="" decoding="async" /><i class="art-b"></i>
                  <svg viewBox="0 0 24 24" class="art-glyph" id="sGlyph" aria-hidden="true"></svg>
                  <span class="mk-chip c1" id="sChip1"></span>
                  <span class="mk-chip c2" id="sChip2"></span>
                </div>
              </div>
              <div class="mk-marquee" aria-hidden="true"><div id="sMarq"></div></div>
              <div id="sBlocks"></div>
            </div>
            <div class="mk-page" data-page="1" hidden>
              <div class="mk-h mk-h2" id="sItemsTitle"></div>
              <div class="mk-items" id="sItems"></div>
            </div>
            <div class="mk-page" data-page="2" hidden>
              <div class="mk-h mk-h2" data-i18n="contact">Επικοινωνία</div>
              <div class="mk-contact">
                <div class="mk-map"><span></span></div>
                <div>
                  <p><b data-i18n="hours">Ωράριο</b><br /><span id="sHours"></span></p>
                  <p><b data-i18n="address">Διεύθυνση</b><br /><span data-i18n="street">Οδός Παραδείγματος 12</span></p>
                </div>
              </div>
              <form class="mk-form" id="sForm" novalidate>
                <input type="text" placeholder="Όνομα" data-i18n-ph="name" aria-label="Όνομα (demo)" autocomplete="off" />
                <input type="text" placeholder="Τηλέφωνο" data-i18n-ph="phone" aria-label="Τηλέφωνο (demo)" autocomplete="off" />
                <button type="submit" class="mk-btn" data-i18n="send">Αποστολή</button>
                <p class="mk-ok" id="sFormOk" hidden data-i18n="formOk">Στάλθηκε! (Είναι demo, δεν έφυγε τίποτα.)</p>
              </form>
            </div>
            <footer class="mk-foot2">
              <div class="mf-brand"><span class="mk-brand"><span class="mk-mark" id="fMark"></span><b id="fName"></b></span><p id="fTag" data-ed="ft" contenteditable="true" spellcheck="false"></p></div>
              <div class="mf-col"><small data-i18n="pages">Σελίδες</small><span id="fLinks"></span></div>
              <div class="mf-col"><small data-i18n="contact">Επικοινωνία</small><span>210 000 0000</span><span id="fMail"></span><span id="fHours"></span></div>
              <div class="mf-col mf-news"><small>Newsletter</small><div><input type="text" placeholder="Το email σου" data-i18n-ph="yourEmail" aria-label="Email (demo)" autocomplete="off" /><button type="button" class="mk-btn" data-news>OK</button></div></div>
            </footer>
            <div class="mk-foot"><span id="sFoot"></span><span>Made by Prelude</span></div>
          </div>
          <!-- AI βοηθός (demo) -->
          <div class="mk-bot" id="sBot">
            <div class="bot-panel" id="botPanel" hidden>
              <div class="bot-head">
                <span class="mk-mark" id="botMark"></span>
                <div><b id="botName"></b><small><i></i><span id="botSub">AI βοηθός · online</span></small></div>
                <button type="button" class="sh-x" data-bot-close aria-label="Κλείσιμο">×</button>
              </div>
              <div class="bot-log" id="botLog" aria-live="polite"></div>
              <div class="bot-quick" id="botQuick"></div>
              <form class="bot-form" id="botForm">
                <input id="botIn" autocomplete="off" maxlength="120" placeholder="Γράψε μια ερώτηση…" aria-label="Ερώτηση στον βοηθό (demo)" />
                <button type="submit" aria-label="Αποστολή">↑</button>
              </form>
            </div>
            <button type="button" class="bot-btn" data-bot-open aria-label="Άνοιγμα βοηθού">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16v11H9l-5 4z"/><path d="M8.5 10.5h.01M12 10.5h.01M15.5 10.5h.01"/></svg><i></i>
            </button>
          </div>
          <div class="mk-sheet" id="sSheet" inert><div class="sh"></div></div>
          <div class="mk-toast" id="sToast" role="status" aria-live="polite"></div>
        </div>

        <!-- Εφαρμογή -->
        <div class="mock mock-app hide" id="mApp" data-style="modern">
          <div class="ap-status"><span>9:41</span><span class="ap-isl"></span><span>▮▮▮</span></div>
          <div class="ap-top">
            <span class="mk-mark" id="pMark"></span>
            <div><small id="pHi"></small><b id="pName"></b></div>
            <button type="button" class="mk-cart" id="pCartBtn" data-cart-open aria-label="Καλάθι" hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2 11h11l2-8H6"/><circle cx="9" cy="19" r="1.5"/><circle cx="17" cy="19" r="1.5"/></svg>
              <b id="pCartN">0</b>
            </button>
          </div>
          <div class="ap-screen" data-tab="0">
            <div class="ap-card">
              <small id="pCardSmall"></small>
              <b id="pCardTitle"></b>
              <button type="button" class="mk-btn" id="pAction"></button>
            </div>
            <div class="ap-sub" data-i18n="popular">Δημοφιλή</div>
            <ul class="ap-list" id="pTop"></ul>
          </div>
          <div class="ap-screen" data-tab="1" hidden>
            <div class="ap-sub" id="pItemsTitle"></div>
            <ul class="ap-list" id="pList"></ul>
          </div>
          <div class="ap-screen" data-tab="2" hidden>
            <div class="ap-sub">Πληροφορίες</div>
            <div class="ap-info"><b>Ωράριο</b><span id="pHours"></span></div>
            <div class="ap-info"><b data-i18n="address">Διεύθυνση</b><span data-i18n="street">Οδός Παραδείγματος 12</span></div>
          </div>
          <div class="ap-tabs" id="pTabs">
            <button type="button" data-tab-go="0" aria-pressed="true"><i class="t-home"></i>Αρχική</button>
            <button type="button" data-tab-go="1" aria-pressed="false"><i class="t-list"></i><span id="pTabList"></span></button>
            <button type="button" data-tab-go="2" aria-pressed="false"><i class="t-info"></i>Εμείς</button>
          </div>
          <div class="mk-sheet" id="pSheet" inert><div class="sh"></div></div>
          <div class="mk-toast" id="pToast" role="status" aria-live="polite"></div>
        </div>


        <!-- Διαχείριση: τι βλέπει ο ιδιοκτήτης -->
        <div class="mock mock-adm hide" id="mAdm" data-style="modern">
          <div class="mk-url"><i></i><i></i><i></i><span id="aUrl"></span></div>
          <div class="ad-wrap">
            <aside class="ad-side">
              <span class="mk-mark" id="aMark"></span>
              <nav>
                <b class="on"><i></i>Πίνακας</b>
                <b><i></i><span id="aNavList">Παραγγελίες</span></b>
                <b><i></i>Πελάτες</b>
                <b><i></i>Μηνύματα</b>
                <b><i></i>Ρυθμίσεις</b>
              </nav>
            </aside>
            <div class="ad-main">
              <div class="ad-top">
                <div><small>Καλημέρα!</small><b id="aName"></b></div>
                <span class="ad-bell" id="aBell"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 16V11a6 6 0 0112 0v5l2 2H4z"/><path d="M10 20a2 2 0 004 0"/></svg><i id="aBellN">0</i></span>
              </div>
              <div class="ad-kpis" id="aKpis"></div>
              <div class="ad-grid">
                <div class="ad-card ad-orders"><div class="ad-h"><b id="aListT"></b><small class="ad-live"><i></i>live</small></div><ul class="ad-list" id="aList"></ul></div>
                <div class="ad-card"><div class="ad-h"><b>Η εβδομάδα σου</b><small id="aChartT"></small></div><div class="ad-chart" id="aChart"></div></div>
              </div>
            </div>
          </div>
          <div class="mk-toast" id="aToast" role="status" aria-live="polite"></div>
        </div>

        <span class="swipe-hint mono" id="swipeHint" aria-hidden="true">‹ σύρε το preview για άλλο ύφος ›</span>
        <span class="build-hint mono" aria-hidden="true">✎ Πάτα σε οποιοδήποτε κείμενο για να το αλλάξεις · μετακίνησε, σβήσε ή πρόσθεσε ενότητες</span>

        <div class="sim-cta">
          <button type="button" class="btn btn-p" id="simwant">Θέλω κάτι τέτοιο <span class="k" aria-hidden="true">↗</span></button>
          <button type="button" class="btn btn-g" id="simsend">Στείλε μου το σχέδιο <span class="k" aria-hidden="true">✉</span></button>
          <span class="mono">Συμπληρώνει τη φόρμα με τις επιλογές σου</span>
        </div>
      </div>
    </div>
  </div>

  <div class="sd-modal" id="sdModal" hidden>
    <div class="sd-box" role="dialog" aria-modal="true" aria-labelledby="sdTitle">
      <button type="button" class="sd-x" data-sd-close aria-label="Κλείσιμο">×</button>
      <span class="mono"><b>[ SIM ]</b> Το σχέδιό σου</span>
      <h3 class="sd-title" id="sdTitle">Στείλε μου το σχέδιο</h3>
      <p class="sd-lead">Άφησε το email σου και θα σου στείλουμε το σχέδιό σου, μαζί με μια πρώτη πρόταση, μέσα σε 24 ώρες.</p>
      <div class="sd-grid">
        <form class="sd-form" id="sdForm" novalidate>
          <label for="sdName">Όνομα</label>
          <input id="sdName" autocomplete="name" maxlength="120" />
          <label for="sdEmail">Email</label>
          <input id="sdEmail" type="email" autocomplete="email" maxlength="160" required />
          <div class="hp" aria-hidden="true"><input id="sdWeb" tabindex="-1" autocomplete="off" /></div>
          <div class="sd-spec" id="sdSpec"></div>
          <button type="submit" class="btn btn-p">Στείλε μου το σχέδιο <span class="k" aria-hidden="true">↗</span></button>
          <span class="status" id="sdStatus" role="status"></span>
          <small class="sd-legal">Χρησιμοποιούμε το email σου μόνο για να σου απαντήσουμε. <a href="/aporrito/">Πολιτική απορρήτου</a></small>
        </form>
        <div class="sd-qr">
          <div class="qr" id="sdQr" aria-label="QR code με τον σύνδεσμο του σχεδίου"></div>
          <small>Σκάναρε με το κινητό σου για να ανοίξεις το σχέδιο εκεί</small>
          <button type="button" class="btn btn-g" id="sdCopy">Αντιγραφή link <span class="k" aria-hidden="true">⧉</span></button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { presets, swatches, styles, icons, layouts, extras, blockLabels, heroLabels, type Kind, type Block, type Hero } from '../data/simulator';
  import { en, ui } from '../data/simulatorEn';

  type Mode = 'site' | 'app' | 'admin';
  type Dev = 'desktop' | 'tablet' | 'phone';
  let dev: Dev = 'desktop';
  const state = { kind: 'bakery' as Kind, mode: 'site' as Mode, style: 'modern', color: 'auto', page: 0, tab: 0, flip: false, font: 'auto', corner: 'auto', lang: 'el' as 'el' | 'en', bi: false, bot: true };
  // Λειτουργίες μέσα στο preview: καλάθι, κράτηση, φόρμες
  const cart = new Map<number, number>();
  const booking = { item: -1, day: 0, slot: -1 };
  let sheet: 'cart' | 'book' | 'done' | null = null;
  let doneText = '';

  const $ = (id: string) => document.getElementById(id)!;
  // Φωτογραφίες (public/sim): φορτώνουν μόνο όταν ο simulator πλησιάσει στην οθόνη
  let photosOn = false;
  const ph = (i: number) => `/sim/${state.kind}-${i}.webp`;
  function setImg(el: HTMLImageElement, src: string) {
    if (el.getAttribute('src') === src) return;
    el.classList.remove('ok');
    el.onload = () => el.classList.add('ok');
    el.src = src;
  }
  const mSite = $('mSite');
  const mApp = $('mApp');
  const mAdm = $('mAdm');
  const mocks = [mSite, mApp, mAdm];
  const curMock = () => (state.mode === 'site' ? mSite : state.mode === 'app' ? mApp : mAdm);
  const input = $('biz') as HTMLInputElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Ελληνικά → λατινικά για το domain
  const gr: Record<string, string> = {
    'α':'a','ά':'a','β':'v','γ':'g','δ':'d','ε':'e','έ':'e','ζ':'z','η':'i','ή':'i','θ':'th','ι':'i','ί':'i','ϊ':'i','ΐ':'i',
    'κ':'k','λ':'l','μ':'m','ν':'n','ξ':'x','ο':'o','ό':'o','π':'p','ρ':'r','σ':'s','ς':'s','τ':'t','υ':'y','ύ':'y','ϋ':'y',
    'φ':'f','χ':'ch','ψ':'ps','ω':'o','ώ':'o',
  };
  const slug = (t: string) =>
    t.toLowerCase().split('').map((c) => gr[c] ?? c).join('')
      .replace(/oy/g, 'ou').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'to-site-sou';
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  // Αν ο επισκέπτης δεν έχει γράψει δικό του όνομα, το όνομα ακολουθεί τον κλάδο (π.χ. «Gym»)
  let nameTouched = false;
  const name = () => input.value.trim() || presets[state.kind].demo;
  const syncDemoName = () => { if (!nameTouched) input.value = presets[state.kind].demo; };
  const initials = (n: string) => n.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase() || 'P';
  const color = () => (state.color === 'auto' ? presets[state.kind].color : state.color);
  const styleLabel = () => styles.find((s) => s.id === state.style)?.label ?? '';
  // Γλώσσα του preview: τα ελληνικά ή τα αγγλικά κείμενα του κλάδου
  const U = () => ui[state.lang];
  const tk = () => (state.lang === 'en' ? state.kind + ':en' : state.kind);
  const langBase = () => {
    const b = presets[state.kind];
    if (state.lang !== 'en') return b;
    const e = en[state.kind];
    return {
      ...b, label: e.label, headline: e.headline, sub: e.sub, cta: e.cta, itemsTitle: e.itemsTitle,
      items: e.items.map(([n, m]) => ({ n, m })), features: [...e.features], greeting: e.greeting, appAction: e.appAction,
      hours: e.hours, bookTitle: e.bookTitle, bookOk: e.bookOk,
    };
  };
  const exx = () => {
    const x = extras[state.kind];
    if (state.lang !== 'en') return x;
    const e = en[state.kind];
    return { steps: e.steps, alert: e.alert, search: e.search, prof: x.prof && e.prof ? { name: x.prof.name, role: e.prof.role, points: e.prof.points } : undefined };
  };
  const preset = () => {
    const base = langBase();
    const t = texts[tk()];
    if (!t) return base;
    return {
      ...base,
      items: base.items.map((it, i) => (t['i' + i] ? { ...it, n: t['i' + i] } : it)),
      features: base.features.map((f, i) => t['f' + i] ?? f),
    };
  };
  // Κείμενα που άλλαξε ο επισκέπτης (ανά κλάδο)
  const texts: Partial<Record<string, Record<string, string>>> = {};
  const T = (key: string, def: string) => texts[tk()]?.[key] ?? def;
  const edA = (key: string) => ` data-ed="${key}" contenteditable="true" spellcheck="false"`;

  // Κονσόλα
  const logEl = $('log');
  let logTimer: ReturnType<typeof setTimeout>;
  function log(lines: string[]) {
    clearTimeout(logTimer);
    let i = 0;
    const next = () => {
      if (i >= lines.length) return;
      const d = document.createElement('div');
      d.innerHTML = lines[i++];
      logEl.appendChild(d);
      while (logEl.children.length > 7) logEl.firstChild!.remove();
      logTimer = setTimeout(next, 150);
    };
    next();
  }

  // Αλλάζει το HTML μόνο αν όντως άλλαξε, ώστε να μην ξαναπαίζουν τα animations σε κάθε πάτημα πλήκτρου
  function setHTML(el: HTMLElement, html: string) {
    // δεν ξαναζωγραφίζει όσο ο επισκέπτης γράφει μέσα στο συγκεκριμένο κομμάτι
    const a = document.activeElement as HTMLElement | null;
    if (a && a.isContentEditable && el.contains(a)) return;
    if (el.dataset.h !== html) { el.innerHTML = html; el.dataset.h = html; }
  }

  function showPage(root: HTMLElement, attr: 'page' | 'tab', idx: number) {
    root.querySelectorAll<HTMLElement>(`[data-${attr}]`).forEach((p) => (p.hidden = Number(p.dataset[attr]) !== idx));
  }

  // ---------- Στοιχεία λίστας ----------
  const glyph = (k: Kind) => `<svg viewBox="0 0 24 24" aria-hidden="true">${icons[k]}</svg>`;
  function actionBtn(it: { n: string }, i: number) {
    return preset().flow === 'cart'
      ? `<button type="button" class="mk-add" data-add="${i}" aria-label="${U().add}: ${esc(it.n)}">+</button>`
      : `<button type="button" class="mk-add mk-add-t" data-book="${i}">${U().book}</button>`;
  }
  function rowHTML(tag: 'div' | 'li', cls: string, it: { n: string; m: string }, i: number) {
    const th = photosOn ? ` ph" style="background-image:url(${ph(1 + (i % 3))})` : '';
    return `<${tag} class="${cls}"><span class="mk-n">${String(i + 1).padStart(2, '0')}</span><span class="mk-thumb${th}">${glyph(state.kind)}</span><div class="mk-it"><b${edA('i' + i)}>${esc(it.n)}</b><small>${esc(it.m)}</small></div>${actionBtn(it, i)}</${tag}>`;
  }

  // ---------- Φύλλα (καλάθι / κράτηση) ----------
  const slots = ['09:00', '10:30', '12:00', '17:00', '18:30', '20:00'];
  const dayLabels = () =>
    Array.from({ length: 5 }, (_, i) => {
      const d = new Date();
      d.setDate(d.getDate() + i + 1);
      return d.toLocaleDateString(U().locale, { weekday: 'short', day: 'numeric' });
    });
  // «πιασμένες» ώρες, πάντα ίδιες για τον ίδιο κλάδο ώστε να φαίνεται ρεαλιστικό
  const taken = (d: number, s: number) => (d * 7 + s * 3 + state.kind.length) % 4 === 0;
  const cartCount = () => [...cart.values()].reduce((a, b) => a + b, 0);

  function sheetHTML(): string {
    const p = preset();
    const head = (t: string) => `<div class="sh-head"><b>${esc(t)}</b><button type="button" class="sh-x" data-sheet-close aria-label="Κλείσιμο">×</button></div>`;
    if (sheet === 'done') {
      return `${head('')}<div class="sh-done"><span class="sh-ok"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></span><b>${esc(doneText)}</b><small>${U().demoNote}</small><button type="button" class="mk-btn" data-sheet-close>${U().ok}</button></div>`;
    }
    if (sheet === 'cart') {
      const rows = [...cart.entries()].map(([i, q]) =>
        `<div class="sh-row"><span>${esc(p.items[i].n)}</span><span class="sh-qty"><button type="button" data-qty="${i}" data-d="-1" aria-label="Λιγότερα">−</button><b>${q}</b><button type="button" data-qty="${i}" data-d="1" aria-label="Περισσότερα">+</button></span></div>`).join('');
      return `${head(U().cart)}${rows || `<p class="sh-empty">${U().emptyCart}</p>`}<button type="button" class="mk-btn sh-go" data-checkout ${cart.size ? '' : 'disabled'}>${U().checkout}</button>`;
    }
    if (sheet === 'book') {
      const days = dayLabels().map((l, i) => `<button type="button" class="chip" data-day="${i}" aria-pressed="${i === booking.day}">${esc(l)}</button>`).join('');
      const sl = slots.map((t, i) => {
        const off = taken(booking.day, i);
        return `<button type="button" class="chip" data-slot="${i}" aria-pressed="${i === booking.slot}" ${off ? 'disabled title="Δεν υπάρχει διαθεσιμότητα"' : ''}>${t}</button>`;
      }).join('');
      const it = booking.item >= 0 ? `<p class="sh-item">${esc(p.items[booking.item].n)}</p>` : '';
      return `${head(p.bookTitle)}${it}<div class="sh-lbl">${U().day}</div><div class="sh-chips">${days}</div><div class="sh-lbl">${U().time}</div><div class="sh-chips">${sl}</div><button type="button" class="mk-btn sh-go" data-confirm ${booking.slot < 0 ? 'disabled' : ''}>${U().confirm}</button>`;
    }
    return '';
  }

  function syncSheet() {
    const html = sheetHTML();
    for (const id of ['sSheet', 'pSheet']) {
      const el = $(id);
      if (sheet) setHTML(el.firstElementChild as HTMLElement, html);
      el.classList.toggle('open', !!sheet);
      el.toggleAttribute('inert', !sheet);
    }
  }

  function updateBadges() {
    const n = cartCount();
    const show = preset().flow === 'cart';
    for (const [btn, num] of [['sCartBtn', 'sCartN'], ['pCartBtn', 'pCartN']]) {
      ($(btn) as HTMLElement).hidden = !show;
      $(num).textContent = String(n);
      $(btn).classList.toggle('has', n > 0);
    }
  }

  let toastTimer: ReturnType<typeof setTimeout>;
  function toast(text: string) {
    for (const id of ['sToast', 'pToast', 'aToast']) { $(id).textContent = text; $(id).classList.add('on'); }
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => ['sToast', 'pToast', 'aToast'].forEach((id) => $(id).classList.remove('on')), 1900);
  }

  // ---------- Πίνακας ιδιοκτήτη: παραγγελίες / κρατήσεις ----------
  type Order = { id: number; title: string; who: string; when: string; st: number };
  let orders: Order[] = [];
  let seq = 1040;
  let added = 0;
  let freshId = 0;
  const stLabels = () => (preset().flow === 'cart' ? ['Νέα', 'Σε ετοιμασία', 'Παραδόθηκε'] : ['Νέα', 'Επιβεβαιώθηκε', 'Ολοκληρώθηκε']);
  const hash = (t: string) => [...t].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
  function seedOrders() {
    const p = preset();
    const who = ['Μ. Παπαδοπούλου', 'Γ. Νικολάου', 'Ε. Δημητρίου'];
    const d = dayLabels();
    orders = [0, 1, 2].map((i) => ({
      id: ++seq,
      title: p.flow === 'cart' ? `${p.items[i].n} ×${(i % 2) + 1}` : p.items[i].n,
      who: who[i],
      when: p.flow === 'cart' ? ['09:12', '10:40', '11:05'][i] : `${d[i]} · ${slots[i + 1]}`,
      st: i,
    }));
    added = 0;
  }
  let noteTimer: ReturnType<typeof setTimeout>;
  function addOrder(title: string, when: string) {
    const o = { id: ++seq, title, who: 'Εσύ (demo)', when, st: 0 };
    orders.unshift(o);
    added++;
    freshId = o.id;
    const isCart = preset().flow === 'cart';
    $('ownNoteT').textContent = `Νέα ${isCart ? 'παραγγελία' : 'κράτηση'} #${o.id} · ο ιδιοκτήτης ειδοποιήθηκε`;
    const note = $('ownNote');
    note.hidden = false;
    note.classList.remove('on'); void note.offsetWidth; note.classList.add('on');
    clearTimeout(noteTimer);
    noteTimer = setTimeout(() => { note.classList.remove('on'); setTimeout(() => (note.hidden = true), 400); }, 6500);
    log([`&gt; notify.owner <span class="hl">#${o.id}</span>`, '<span class="ok">✓ push + email στον ιδιοκτήτη</span>']);
  }

  function resetFlow() {
    cart.clear();
    booking.item = -1; booking.day = 0; booking.slot = -1;
    sheet = null;
    seedOrders();
    botReset();
  }

  // ---------- Λογότυπο / φωτογραφία του επισκέπτη (μένουν μόνο στον browser) ----------
  let userLogo: string | null = null;
  let userPhoto: string | null = null;
  // Παίρνει το κυρίαρχο «ζωντανό» χρώμα του λογότυπου
  async function logoColor(url: string): Promise<string | null> {
    try {
      const img = new Image();
      img.src = url;
      await img.decode();
      const c = document.createElement('canvas');
      c.width = c.height = 48;
      const x = c.getContext('2d', { willReadFrequently: true })!;
      x.drawImage(img, 0, 0, 48, 48);
      const d = x.getImageData(0, 0, 48, 48).data;
      const buckets = new Map<number, { w: number; r: number; g: number; b: number }>();
      for (let i = 0; i < d.length; i += 4) {
        const [r, g, b, a] = [d[i], d[i + 1], d[i + 2], d[i + 3]];
        if (a < 140) continue;
        const max = Math.max(r, g, b), min = Math.min(r, g, b);
        const l = (max + min) / 510;
        const sat = max === min ? 0 : (max - min) / (255 - Math.abs(max + min - 255));
        if (l > 0.93 || l < 0.07 || sat < 0.22) continue;
        const key = ((r >> 5) << 6) | ((g >> 5) << 3) | (b >> 5);
        const e = buckets.get(key) ?? { w: 0, r: 0, g: 0, b: 0 };
        const w = 0.5 + sat;
        e.w += w; e.r += r * w; e.g += g * w; e.b += b * w;
        buckets.set(key, e);
      }
      let best: { w: number; r: number; g: number; b: number } | null = null;
      for (const e of buckets.values()) if (!best || e.w > best.w) best = e;
      if (!best || best.w < 8) return null;
      const hex = (v: number) => Math.round(v / best!.w).toString(16).padStart(2, '0');
      return `#${hex(best.r)}${hex(best.g)}${hex(best.b)}`.toUpperCase();
    } catch { return null; }
  }

  // ---------- Λογότυπο από το όνομα ----------
  function logo(n: string) {
    const ini = initials(n);
    const h = hash(n);
    const shapes = [
      '<circle cx="20" cy="20" r="18"/>',
      '<path d="M20 1.5L38.5 20 20 38.5 1.5 20z"/>',
      '<path d="M20 2l15.6 9v18L20 38 4.4 29V11z"/>',
      '<rect x="2" y="2" width="36" height="36" rx="11"/>',
    ];
    const accents = ['<circle class="lg-dot" cx="32" cy="8" r="3.4"/>', '<path class="lg-ln" d="M10 31.5h20"/>', '', '<path class="lg-ln" d="M28 6l6 6"/>'];
    return `<svg class="lg" viewBox="0 0 40 40" aria-hidden="true"><g class="lg-sh">${shapes[h % 4]}</g>${accents[(h >> 3) % 4]}<text class="lg-t${ini.length > 1 ? ' two' : ''}" x="20" y="21.5" text-anchor="middle" dominant-baseline="middle">${esc(ini)}</text></svg>`;
  }


  // ---------- Ενότητες (blocks) και builder ----------
  const allBlocks = Object.keys(blockLabels) as Block[];
  const lay: Partial<Record<Kind, { hero: Hero; blocks: Block[] }>> = {};
  const curLay = () => (lay[state.kind] ??= { hero: layouts[state.kind].hero, blocks: [...layouts[state.kind].blocks] });
  let addOpen = false;
  let flashBlk: Block | null = null;
  const ctaAttr = () => (preset().flow === 'cart' ? 'data-go="1"' : 'data-book="-1"');
  const bgPh = (i: number) => (photosOn ? ` style="background-image:url(${ph(i)})"` : '');

  function searchHTML() {
    const ex = exx();
    const d = dayLabels();
    const val: Record<string, string> = {
      'Άφιξη': d[0], 'Αναχώρηση': d[2], 'Ημερομηνία': d[0], 'Ώρα': '21:00', 'Ημέρα': d[0], 'Περιοχή': 'Αθήνα',
      'Τύπος ακινήτου': 'Διαμέρισμα', 'τ.μ.': '60–120', 'Αριθμός κυκλοφορίας': 'ΙΚΧ 1234', 'Μάρκα / μοντέλο': 'Όλες', 'Ζώο': 'Σκύλος', 'Άτομα': '2 άτομα', 'Επισκέπτες': '2 ενήλικες',
      'Check-in': d[0], 'Check-out': d[2], 'Date': d[0], 'Time': '21:00', 'Day': d[0], 'Guests': state.kind === 'hotel' ? '2 adults' : '2 people',
      'Area': 'Athens', 'Property type': 'Apartment', 'm²': '60–120', 'Licence plate': 'IKX 1234', 'Make / model': 'All', 'Pet': 'Dog',
    };
    const fields = ex.search.map((f) =>
      `<button type="button" class="ms-f${f.includes('κυκλοφορίας') || f.includes('plate') ? ' plate' : ''}" ${ctaAttr()}><small>${esc(f)}</small><b>${esc(val[f] ?? U().all)}</b></button>`).join('');
    return `${fields}<button type="button" class="mk-btn ms-go" ${ctaAttr()}>${preset().flow === 'cart' ? U().search : U().avail}</button>`;
  }

  function blockHTML(b: Block): string {
    const p = preset();
    const ex = exx();
    const u = U();
    const cart = p.flow === 'cart';
    const h3 = (key: string, def: string) => `<div class="mk-h mk-h2 mk-h3"${edA(key)}>${esc(T(key, def))}</div>`;
    switch (b) {
      case 'feats':
        return `<div class="mk-feats">${p.features.map((f, i) => `<div><i></i><span${edA('f' + i)}>${esc(f)}</span></div>`).join('')}</div>`;
      case 'pop':
        return h3('popT', cart ? u.popular : p.itemsTitle) + `<div class="mk-items">${p.items.slice(0, 4).map((it, i) => rowHTML('div', 'mk-item', it, i)).join('')}</div>`;
      case 'cards':
        return h3('cardsT', cart ? u.newIn : p.itemsTitle) + `<div class="mk-cards">${p.items.slice(0, 3).map((it, i) =>
          `<article class="mk-card"><div class="mc-img"${bgPh(1 + i)}><span class="mc-badge">${esc(it.m)}</span></div><div class="mc-body"><b${edA('i' + i)}>${esc(it.n)}</b><small>${esc(p.label)}</small>${actionBtn(it, i)}</div></article>`).join('')}</div>`;
      case 'gal':
        return photosOn
          ? `<div class="mk-gal">${[1, 2, 3].map((i, n) => `<figure><img src="${ph(i)}" alt="" loading="lazy" decoding="async" onload="this.classList.add('ok')"><figcaption${edA('f' + n)}>${esc(p.features[n] ?? '')}</figcaption></figure>`).join('')}</div>`
          : `<div class="mk-gal">${[0, 1, 2].map((n) => `<figure><figcaption${edA('f' + n)}>${esc(p.features[n] ?? '')}</figcaption></figure>`).join('')}</div>`;
      case 'menu':
        return `<div class="mk-menu">${h3('menuT', p.itemsTitle)}${p.items.map((it, i) => `<div class="mm-row"><b${edA('i' + i)}>${esc(it.n)}</b><i></i><small>${esc(it.m)}</small></div>`).join('')}<button type="button" class="mk-btn" ${ctaAttr()}>${esc(p.cta)}</button></div>`;
      case 'tt': {
        const days = state.lang === 'en' ? ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'] : ['Δευ', 'Τρί', 'Τετ', 'Πέμ', 'Παρ'];
        return h3('ttT', u.schedule) + `<div class="mk-tt">${days.map((d, di) => `<div><h4>${d}</h4>${[0, 1].map((j) => {
          const i = (di + j * 2) % p.items.length;
          return `<button type="button" data-book="${i}"><small>${slots[(di + j * 3) % slots.length]}</small><b>${esc(p.items[i].n)}</b></button>`;
        }).join('')}</div>`).join('')}</div>`;
      }
      case 'steps':
        return h3('stT', u.how) + `<div class="mk-steps">${ex.steps.map(([t, d], i) => `<div><span>${i + 1}</span><b${edA('s' + i + 't')}>${esc(T('s' + i + 't', t))}</b><p${edA('s' + i + 'd')}>${esc(T('s' + i + 'd', d))}</p></div>`).join('')}</div>`;
      case 'prof': {
        const pr = ex.prof ?? { name: name(), role: p.label, points: p.features };
        return `<div class="mk-prof"><div class="mp-img"${bgPh(state.kind === 'clinic' ? 0 : 1)}></div><div><small>${u.meet}</small><b${edA('pN')}>${esc(T('pN', pr.name))}</b><span class="mp-role"${edA('pR')}>${esc(T('pR', pr.role))}</span><ul>${pr.points.map((x, i) => `<li${edA('pP' + i)}>${esc(T('pP' + i, x))}</li>`).join('')}</ul><button type="button" class="mk-btn" ${ctaAttr()}>${esc(p.cta)}</button></div></div>`;
      }
      case 'alert':
        return `<div class="mk-alert"><i></i><span${edA('al')}>${esc(T('al', ex.alert))}</span><button type="button" data-go="2">${u.more}</button></div>`;
      case 'band':
        return `<div class="mk-band"><b${edA('bd')}>${esc(T('bd', cart ? u.bandCart : u.bandBook))}</b><button type="button" class="mk-btn" ${ctaAttr()}>${esc(p.cta)}</button></div>`;
      case 'faq':
        return h3('fqT', u.faqT) + `<div class="mk-faq">${[
          [cart ? u.faq[0][0] : (state.lang === 'en' ? u.faq[0][1] : `Πώς κάνω ${p.bookTitle.replace('Κλείσε ', '').toLowerCase()};`), u.faq[1]],
          [u.faq[2], p.hours],
          [u.faq[3], u.faq[4]],
        ].map(([q, a], i) => `<details${i === 0 ? ' open' : ''}><summary><span${edA('q' + i)}>${esc(T('q' + i, q))}</span></summary><p${edA('a' + i)}>${esc(T('a' + i, a))}</p></details>`).join('')}</div>`;
    }
  }
  function blockWrap(b: Block, i: number, n: number) {
    return `<section class="blk${flashBlk === b ? ' flash' : ''}" data-b="${b}"><div class="blk-bar"><span>${esc(blockLabels[b])}</span>` +
      `<button type="button" data-bmv="-1" data-bi="${i}" title="Πάνω" ${i === 0 ? 'disabled' : ''}>↑</button>` +
      `<button type="button" data-bmv="1" data-bi="${i}" title="Κάτω" ${i === n - 1 ? 'disabled' : ''}>↓</button>` +
      `<button type="button" data-bdel="${i}" title="Αφαίρεση" ${n <= 1 ? 'disabled' : ''}>✕</button></div>${blockHTML(b)}</section>`;
  }
  function addMenuHTML(cur: Block[]) {
    const rest = allBlocks.filter((b) => !cur.includes(b));
    return `<div class="blk-add${addOpen ? ' open' : ''}"><button type="button" class="blk-add-btn" data-badd-open>＋ Πρόσθεσε ενότητα</button><div class="blk-menu">${
      rest.length ? rest.map((b) => `<button type="button" data-badd="${b}">${esc(blockLabels[b])}</button>`).join('') : '<small>Έχεις βάλει όλες τις ενότητες</small>'}</div></div>`;
  }
  function blkCtlHTML(L: { hero: Hero; blocks: Block[] }) {
    const n = L.blocks.length;
    return `<button type="button" class="bc-hero" data-hero-cycle>Hero: ${esc(heroLabels[L.hero])} <span aria-hidden="true">⇄</span></button>` +
      L.blocks.map((b, i) => `<span class="bc"><b>${esc(blockLabels[b])}</b><button type="button" data-bmv="-1" data-bi="${i}" aria-label="Πάνω" ${i === 0 ? 'disabled' : ''}>↑</button><button type="button" data-bmv="1" data-bi="${i}" aria-label="Κάτω" ${i === n - 1 ? 'disabled' : ''}>↓</button><button type="button" data-bdel="${i}" aria-label="Αφαίρεση" ${n <= 1 ? 'disabled' : ''}>✕</button></span>`).join('') +
      allBlocks.filter((b) => !L.blocks.includes(b)).map((b) => `<button type="button" class="bc-add" data-badd="${b}">＋ ${esc(blockLabels[b])}</button>`).join('');
  }

  // Ενέργειες του builder (από το preview ή από τα controls)
  let flashTimer: ReturnType<typeof setTimeout>;
  function builderAction(t: HTMLElement): boolean {
    if (t.closest('[data-hero-cycle], [data-bmv], [data-bdel], [data-badd]')) pushHist();
    const L = curLay();
    let el: HTMLElement | null;
    let msg = '';
    let focus: Block | null = null;
    if ((el = t.closest('[data-hero-cycle]'))) {
      const order: Hero[] = ['split', 'cover', 'search'];
      L.hero = order[(order.indexOf(L.hero) + 1) % order.length];
      msg = `hero --${L.hero}`;
    } else if ((el = t.closest<HTMLElement>('[data-bmv]'))) {
      const i = Number(el.dataset.bi), j = i + Number(el.dataset.bmv);
      if (j < 0 || j >= L.blocks.length) return true;
      [L.blocks[i], L.blocks[j]] = [L.blocks[j], L.blocks[i]];
      focus = L.blocks[j];
      msg = `move ${focus} → ${j + 1}`;
    } else if ((el = t.closest<HTMLElement>('[data-bdel]'))) {
      if (L.blocks.length <= 1) return true;
      const [b] = L.blocks.splice(Number(el.dataset.bdel), 1);
      msg = `remove ${b}`;
    } else if (t.closest('[data-badd-open]')) {
      addOpen = !addOpen;
      paint({ log: false });
      return true;
    } else if ((el = t.closest<HTMLElement>('[data-badd]'))) {
      const b = el.dataset.badd as Block;
      if (!L.blocks.includes(b)) {
        const at = L.blocks.indexOf('faq');
        L.blocks.splice(at >= 0 ? at : L.blocks.length, 0, b);
      }
      addOpen = false;
      focus = b;
      msg = `add ${b}`;
    } else return false;

    if (state.mode !== 'site') document.querySelector<HTMLButtonElement>('#mode [data-m="site"]')?.click();
    flashBlk = focus;
    clearTimeout(flashTimer);
    flashTimer = setTimeout(() => { flashBlk = null; }, 1400);
    buildStatus();
    paint({ log: false });
    log([`&gt; layout.${msg}`, '<span class="ok">✓ η σελίδα ξαναστήθηκε</span>']);
    if (state.page !== 0) { state.page = 0; paint({ log: false }); }
    requestAnimationFrame(() => {
      const target = focus ? sBody.querySelector<HTMLElement>(`.blk[data-b="${focus}"]`) : msg.startsWith('hero') ? sBody.querySelector<HTMLElement>('.mk-hero') : null;
      if (!target) return;
      const top = target.getBoundingClientRect().top - sBody.getBoundingClientRect().top + sBody.scrollTop - 24;
      sBody.scrollTo({ top: Math.max(0, top), behavior: reduce ? 'auto' : 'smooth' });
    });
    return true;
  }

  // ---------- Ζωγραφίζει όλο το preview ----------
  let swapTimer: ReturnType<typeof setTimeout>;
  // Πάνω δεξιά: σύντομο «compiling → ready» σε κάθε αλλαγή
  const resText = () =>
    state.mode === 'app' ? '390 × 844' : state.mode === 'admin' ? 'admin · 1440 × 900' : ({ desktop: '1440 × 900', tablet: '820 × 1180', phone: '390 × 844' } as const)[dev];
  let statusUntil = 0;
  let statusTimers: ReturnType<typeof setTimeout>[] = [];
  function buildStatus() {
    const res = $('res');
    statusTimers.forEach(clearTimeout);
    statusUntil = performance.now() + 1900;
    res.className = 'corner mono busy';
    res.textContent = 'compiling…';
    statusTimers = [
      setTimeout(() => { res.className = 'corner mono done'; res.textContent = `✓ ready ${(0.18 + Math.random() * 0.3).toFixed(2)}s`; }, 520),
      setTimeout(() => { res.className = 'corner mono'; res.textContent = resText(); }, 1900),
    ];
  }
  // Ομαλή αλλαγή: σβήνει σιγά-σιγά το παλιό, γεμίζει το νέο και το «φέρνει» μέσα με animation
  function render(opts: { log?: boolean; flash?: boolean } = {}) {
    if (!opts.flash || reduce) return paint(opts);
    buildStatus();
    const el = curMock();
    clearTimeout(swapTimer);
    const leaving = mocks.find((m) => !m.classList.contains('hide'));
    (leaving ?? el).classList.add('out');
    swapTimer = setTimeout(() => {
      mocks.forEach((m) => m.classList.remove('out', 'in'));
      paint(opts);
      void el.offsetWidth;
      el.classList.add('in', 'build');
      setTimeout(() => el.classList.remove('build'), 1000);
      setTimeout(() => el.classList.remove('in'), 600);
    }, 190);
  }

  function paint(opts: { log?: boolean } = {}) {
    const p = preset();
    const n = name();
    const c = color();
    const ini = initials(n);
    const cartKind = p.flow === 'cart';

    for (const m of mocks) {
      m.style.setProperty('--k', c);
      m.dataset.style = state.style;
      // το «Τολμηρό» είναι από φύση σκούρο, οπότε εκεί το κουμπί δίνει φωτεινό
      // τα σκούρα από φύση ύφη: εκεί το κουμπί δίνει φωτεινό
      const dark = ['bold', 'neon', 'luxury'].includes(state.style) ? !state.flip : state.flip;
      m.dataset.mode = dark ? 'dark' : 'light';
      m.dataset.font = state.font;
      m.dataset.corner = state.corner;
    }

    // Φωτογραφίες (η δική του φωτογραφία, αν ανέβασε, μπαίνει στο hero)
    if (photosOn || userPhoto) {
      const hero = userPhoto ?? ph(0);
      setImg($('sPh') as HTMLImageElement, hero);
      for (const m of mocks) {
        m.classList.add('photos');
        m.style.setProperty('--ph', `url("${hero}")`);
        if (photosOn) m.style.setProperty('--ph3', `url(${ph(3)})`);
      }
    }

    // Ιστοσελίδα
    $('url').textContent = slug(n) + '.gr';
    $('sName').textContent = n;
    const lg = userLogo ? `<img src="${userLogo}" alt="">` : logo(n);
    for (const id of ['sMark', 'pMark', 'aMark', 'fMark', 'botMark']) {
      setHTML($(id), lg);
      $(id).classList.toggle('has-img', !!userLogo);
    }

    // Γλώσσα: στατικά κείμενα του preview
    const u = U();
    for (const m of [mSite, mApp]) {
      m.querySelectorAll<HTMLElement>('[data-i18n]').forEach((e) => { e.textContent = (u as Record<string, unknown>)[e.dataset.i18n!] as string; });
      m.querySelectorAll<HTMLInputElement>('[data-i18n-ph]').forEach((e) => { e.placeholder = (u as Record<string, unknown>)[e.dataset.i18nPh!] as string; });
    }
    mSite.dataset.lang = state.lang;
    paintBot();
    const tx = texts[tk()] ?? {};
    const L = curLay();
    if (document.activeElement !== $('sHead')) $('sHead').textContent = tx.h ?? p.headline;
    if (document.activeElement !== $('sSub')) $('sSub').textContent = tx.s ?? p.sub;
    mSite.dataset.hero = L.hero;
    $('sItemsTitle').textContent = p.itemsTitle;
    $('sHours').textContent = p.hours;
    $('sFoot').textContent = `© ${new Date().getFullYear()} ${n}`;
    $('fName').textContent = n;
    if (document.activeElement !== $('fTag')) $('fTag').textContent = T('ft', p.sub);
    $('fMail').textContent = `info@${slug(n)}.gr`;
    $('fHours').textContent = p.hours;
    $('sGlyph').innerHTML = icons[state.kind];
    if (document.activeElement !== $('sKicker')) $('sKicker').textContent = T('k', p.label);
    $('sHoursMini').textContent = p.hours;
    $('sChip1').innerHTML = `<i></i>${esc(p.items[0].m)} · ${esc(p.items[0].n)}`;
    $('sChip2').textContent = p.hours;
    const rep = p.features.map(esc).join(' ✦ ') + ' ✦ ';
    setHTML($('sMarq'), `<span>${rep.repeat(3)}</span><span>${rep.repeat(3)}</span>`);

    // Το κύριο κουμπί: στο καλάθι/κατάλογο ή σε κράτηση
    const b0 = $('sCta');
    b0.textContent = p.cta;
    if (cartKind) { b0.setAttribute('data-go', '1'); b0.removeAttribute('data-book'); }
    else { b0.removeAttribute('data-go'); b0.setAttribute('data-book', '-1'); }
    setHTML($('sSearch'), searchHTML());

    const navLabels = [U().home, p.itemsTitle, U().contact];
    setHTML($('sNav'), navLabels
      .map((l, i) => `<button type="button" data-go="${i}" aria-pressed="${i === state.page}">${esc(l)}</button>`)
      .join(''));
    // Ενότητες της αρχικής, με τη σειρά που έχει διαλέξει ο επισκέπτης
    setHTML($('sBlocks'), L.blocks.map((b, i) => blockWrap(b, i, L.blocks.length)).join('') + addMenuHTML(L.blocks));
    setHTML($('blkCtl'), blkCtlHTML(L));
    setHTML($('sItems'), p.items.map((it, i) => rowHTML('div', 'mk-item', it, i)).join(''));
    setHTML($('fLinks'), navLabels.map((l, i) => `<button type="button" data-go="${i}">${esc(l)}</button>`).join(''));
    mSite.dataset.dev = dev;
    showPage(mSite, 'page', state.page);

    // Εφαρμογή
    $('pName').textContent = n;
    $('pHi').textContent = p.greeting;
    $('pCardSmall').textContent = p.hours;
    $('pCardTitle').textContent = tx.h ?? p.headline;
    const act = $('pAction');
    act.textContent = p.appAction;
    if (cartKind) { act.setAttribute('data-tab-go', '1'); act.removeAttribute('data-book'); }
    else { act.removeAttribute('data-tab-go'); act.setAttribute('data-book', '-1'); }
    $('pItemsTitle').textContent = p.itemsTitle;
    $('pTabList').textContent = p.itemsTitle;
    $('pHours').textContent = p.hours;
    setHTML($('pTop'), p.items.slice(0, 3).map((it, i) => rowHTML('li', '', it, i)).join(''));
    setHTML($('pList'), p.items.map((it, i) => rowHTML('li', '', it, i)).join(''));
    $('pTabs').querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(Number(b.dataset.tabGo) === state.tab)));
    showPage(mApp, 'tab', state.tab);

    // Πίνακας ιδιοκτήτη
    const sl = stLabels();
    $('aUrl').textContent = `admin.${slug(n)}.gr`;
    $('aName').textContent = n;
    $('aNavList').textContent = cartKind ? 'Παραγγελίες' : 'Κρατήσεις';
    $('aListT').textContent = cartKind ? 'Τελευταίες παραγγελίες' : 'Επόμενες κρατήσεις';
    const base = 9 + (hash(state.kind) % 9);
    const kpis: [string, string][] = [
      [cartKind ? 'Παραγγελίες σήμερα' : 'Κρατήσεις σήμερα', String(base + added)],
      ['Νέοι πελάτες', String(3 + (hash(n) % 4) + added)],
      ['Επισκέψεις site', String(240 + (hash(state.kind + n) % 180) + added * 9)],
      ['Μηνύματα', String(2 + (hash(n) % 3))],
    ];
    setHTML($('aKpis'), kpis.map(([l, v], i) => `<div${i === 0 && added ? ' class="up"' : ''}><small>${esc(l)}</small><b>${v}</b></div>`).join(''));
    setHTML($('aList'), orders.slice(0, 5).map((o) =>
      `<li${o.id === freshId ? ' class="fresh"' : ''}><span class="ad-id">#${o.id}</span><div><b>${esc(o.title)}</b><small>${esc(o.who)} · ${esc(o.when)}</small></div><button type="button" class="ad-st s${o.st}" data-st="${o.id}" title="Άλλαξε κατάσταση">${sl[o.st]}</button></li>`).join(''));
    freshId = 0;
    const days = ['Δ', 'Τ', 'Τ', 'Π', 'Π', 'Σ', 'Κ'];
    const hs = days.map((_, i) => 30 + (hash(state.kind + i) % 60));
    const today = (new Date().getDay() + 6) % 7;
    hs[today] = Math.min(100, hs[today] + added * 8);
    setHTML($('aChart'), hs.map((h, i) => `<span${i === today ? ' class="now"' : ''}><i style="height:${h}%"></i><small>${days[i]}</small></span>`).join(''));
    $('aChartT').textContent = cartKind ? 'παραγγελίες' : 'κρατήσεις';
    $('aBellN').textContent = String(added);
    $('aBell').classList.toggle('has', added > 0);

    mocks.forEach((m) => m.classList.toggle('hide', m !== curMock()));
    simEl.dataset.mode = state.mode;
    setHTML($('specBox'), specHTML());
    updHist();
    if (state.mode === 'admin') { const nt = $('ownNote'); nt.classList.remove('on'); nt.hidden = true; }
    if (performance.now() > statusUntil) $('res').textContent = resText();
    updateBadges();
    syncSheet();
    if (typeof armReveal === 'function') requestAnimationFrame(armReveal);

    if (opts.log !== false) {
      log([
        `&gt; build <span class="hl">${esc(slug(n))}</span> --${state.mode}${state.mode === 'site' ? ' --' + dev : ''}`,
        `&gt; layout ${state.kind} · style ${state.style}`,
        `&gt; theme ${c}`,
        '&gt; compiling components…',
        `<span class="ok">✓ ready in ${(0.25 + Math.random() * 0.5).toFixed(2)}s</span>`,
      ]);
    }
  }

  // Ομάδες κουμπιών (κλάδος, τύπος, ύφος)
  function group(id: string, onPick: (b: HTMLButtonElement) => void) {
    const buttons = [...document.querySelectorAll<HTMLButtonElement>(`#${id} > button`)];
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        if (b.getAttribute('aria-pressed') !== 'true') pushHist();
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        onPick(b);
        render({ flash: true });
      }),
    );
    return buttons;
  }
  const kindBtns = group('kinds', (b) => { state.kind = b.dataset.k as Kind; state.page = 0; state.tab = 0; syncDemoName(); resetFlow(); });
  group('mode', (b) => { state.mode = b.dataset.m as Mode; sheet = null; });
  const styleBtns = group('styles', (b) => { state.style = b.dataset.s!; });
  const fontBtns = group('fonts', (b) => { state.font = b.dataset.f!; });
  const cornerBtns = group('corners', (b) => { state.corner = b.dataset.r!; });

  // Χρώματα
  const swBtns = [...document.querySelectorAll<HTMLButtonElement>('#swatches > button')];
  const custom = $('swcustom') as HTMLInputElement;
  const customLabel = custom.parentElement!;
  function pickColor(c: string, fromCustom = false) {
    state.color = c;
    swBtns.forEach((x) => x.setAttribute('aria-pressed', String(!fromCustom && x.dataset.c === c)));
    customLabel.classList.toggle('on', fromCustom);
    if (fromCustom) customLabel.style.setProperty('--sw', c);
  }
  swBtns.forEach((b) => b.addEventListener('click', () => { pushHist(); pickColor(b.dataset.c!); render(); }));
  customLabel.addEventListener('pointerdown', () => pushHist());
  custom.addEventListener('input', () => { pickColor(custom.value, true); render({ log: false }); });
  custom.addEventListener('change', () => render());

  // Dark / Light
  const flipBtn = $('simflip');
  flipBtn.addEventListener('click', () => {
    pushHist();
    state.flip = !state.flip;
    flipBtn.setAttribute('aria-pressed', String(state.flip));
    paint({ log: false });
    log([`&gt; theme --${mSite.dataset.mode}`, '<span class="ok">✓ applied</span>']);
  });

  // ---------- Αλληλεπίδραση μέσα στα mockups ----------
  function onAction(e: Event) {
    const t = e.target as HTMLElement;
    const p = preset();
    const q = <T extends HTMLElement = HTMLElement>(sel: string) => t.closest<T>(sel);
    let el: HTMLElement | null;

    if (q('[contenteditable]')) { if (q('summary')) e.preventDefault(); return; }
    if (q('[data-lang-toggle]')) {
      pushHist();
      state.lang = state.lang === 'el' ? 'en' : 'el';
      state.bi = true;
      botReset();
      render({ flash: true });
      log([`&gt; i18n --${state.lang}`, '<span class="ok">✓ δίγλωσσο site</span>']);
      return;
    }
    if (q('[data-bot-open]')) { botOpen = !botOpen; botSeen = true; paintBot(); if (botOpen) log(['&gt; ai.chat --open', '<span class="ok">✓</span>']); return; }
    if (q('[data-bot-close]')) { botOpen = false; paintBot(); return; }
    if ((el = q('[data-bot-q]'))) { botAsk(el.textContent ?? '', el.dataset.botQ); return; }
    if (q('.bot-cta')) { botOpen = false; paintBot(); }
    if (t.classList.contains('mk-sheet') || q('[data-sheet-close]')) { sheet = null; syncSheet(); return; }
    if (builderAction(t)) return;
    // σε οθόνες αφής η γραμμή εργαλείων εμφανίζεται με ένα άγγιγμα στην ενότητα
    const blk = q('.blk');
    if (blk && !q('button, a, input, summary, [contenteditable]')) {
      mSite.querySelectorAll('.blk.hot').forEach((x) => x !== blk && x.classList.remove('hot'));
      blk.classList.toggle('hot');
    }

    if ((el = q('[data-st]'))) {
      const o = orders.find((x) => x.id === Number(el!.dataset.st));
      if (o && o.st < 2) {
        o.st++;
        paint({ log: false });
        toast(o.st === 1 ? 'Ο πελάτης ενημερώθηκε με SMS' : 'Ολοκληρώθηκε ✓');
        log([`&gt; order.update #${o.id}`, `<span class="ok">✓ ${esc(stLabels()[o.st])}</span>`]);
      }
      return;
    }
    if (q('[data-news]')) { toast('Εγγράφηκες! (demo)'); return; }

    if ((el = q('[data-go]'))) {
      state.page = Number(el.dataset.go);
      paint({ log: false });
      $('sBody').scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      return;
    }
    if ((el = q('[data-tab-go]'))) { state.tab = Number(el.dataset.tabGo); paint({ log: false }); return; }

    if ((el = q('[data-add]'))) {
      const i = Number(el.dataset.add);
      cart.set(i, (cart.get(i) ?? 0) + 1);
      updateBadges();
      toast(`${U().added}: ${p.items[i].n}`);
      log([`&gt; cart.add <span class="hl">"${esc(p.items[i].n)}"</span>`, `<span class="ok">✓ ${cartCount()} προϊόντα στο καλάθι</span>`]);
      return;
    }
    if ((el = q('[data-book]'))) {
      booking.item = Number(el.dataset.book);
      booking.day = 0;
      booking.slot = -1;
      sheet = 'book';
      syncSheet();
      log(['&gt; booking.open', '&gt; διαθεσιμότητα: ok']);
      return;
    }
    if (q('[data-cart-open]')) { sheet = 'cart'; syncSheet(); return; }

    if ((el = q('[data-qty]'))) {
      const i = Number(el.dataset.qty);
      const next = (cart.get(i) ?? 0) + Number(el.dataset.d);
      if (next <= 0) cart.delete(i); else cart.set(i, next);
      updateBadges();
      syncSheet();
      return;
    }
    if ((el = q('[data-day]'))) { booking.day = Number(el.dataset.day); booking.slot = -1; syncSheet(); return; }
    if ((el = q('[data-slot]'))) { booking.slot = Number(el.dataset.slot); syncSheet(); return; }

    if (q('[data-confirm]')) {
      addOrder(booking.item >= 0 ? p.items[booking.item].n : p.bookTitle.replace('Κλείσε ', ''), `${dayLabels()[booking.day]} · ${slots[booking.slot]}`);
      paint({ log: false });
      doneText = p.bookOk;
      sheet = 'done';
      booking.slot = -1;
      syncSheet();
      log(['&gt; booking.confirm', `<span class="ok">✓ ${esc(p.bookOk)}</span>`]);
      return;
    }
    if (q('[data-checkout]')) {
      addOrder([...cart.entries()].map(([i, k]) => `${p.items[i].n} ×${k}`).join(', '), 'τώρα');
      doneText = U().orderSent;
      sheet = 'done';
      cart.clear();
      updateBadges();
      paint({ log: false });
      log(['&gt; order.create', '<span class="ok">✓ η παραγγελία στάλθηκε</span>']);
    }
  }
  // Κινητό: καρτέλες στο dock και το preview να μένει πάντα στην οθόνη
  const ctrl = $('simctrl');
  const mobile = matchMedia('(max-width: 1000px)');
  ctrl.querySelectorAll<HTMLButtonElement>('.ctabs [data-g]').forEach((t) =>
    t.addEventListener('click', () => {
      ctrl.querySelectorAll<HTMLButtonElement>('.ctabs [data-g]').forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      ctrl.querySelectorAll<HTMLElement>('.cg').forEach((g) => g.classList.toggle('on', g.dataset.g === t.dataset.g));
      t.scrollIntoView({ block: 'nearest', inline: 'center', behavior: reduce ? 'auto' : 'smooth' });
    }));
  ctrl.addEventListener('click', (e) => {
    const bt = (e.target as HTMLElement).closest<HTMLElement>('#blkCtl [data-bmv], #blkCtl [data-bdel], #blkCtl [data-badd], #blkCtl [data-hero-cycle]');
    if (bt) { builderAction(bt); return; }
    if (!e.isTrusted || !mobile.matches || !(e.target as HTMLElement).closest('.cg button, .cg .sw')) return;
    const view = ctrl.parentElement!.querySelector<HTMLElement>('.view')!;
    const top = view.getBoundingClientRect().top;
    if (top < -24 || top > 140) {
      scrollTo({ top: scrollY + top - 8, behavior: reduce ? 'auto' : 'smooth' });
    }
  });

  // ---------- Swipe στο κινητό: αλλάζει ύφος ----------
  const simEl = ctrl.parentElement!;
  const viewEl = simEl.querySelector<HTMLElement>('.view')!;
  let sx = 0, sy = 0, noSwipe = false;
  // Αν το άγγιγμα ξεκίνησε μέσα σε κάτι που κυλάει οριζόντια (π.χ. «Νέα στο κατάστημα»), δεν αλλάζουμε ύφος
  const inHScroll = (el: Element | null) => {
    for (let n = el as HTMLElement | null; n && n !== viewEl; n = n.parentElement) {
      if (n.scrollWidth > n.clientWidth + 2) {
        const ox = getComputedStyle(n).overflowX;
        if (ox === 'auto' || ox === 'scroll') return true;
      }
    }
    return false;
  };
  viewEl.addEventListener('touchstart', (e) => {
    sx = e.touches[0].clientX; sy = e.touches[0].clientY;
    noSwipe = e.touches.length > 1 || inHScroll(e.target as Element);
  }, { passive: true });
  viewEl.addEventListener('touchend', (e) => {
    if (noSwipe) return;
    const t = e.changedTouches[0];
    const dx = t.clientX - sx, dy = t.clientY - sy;
    if (Math.abs(dx) < 60 || Math.abs(dx) < Math.abs(dy) * 1.6) return;
    const i = styleBtns.findIndex((b) => b.dataset.s === state.style);
    styleBtns[(i + (dx < 0 ? 1 : -1) + styleBtns.length) % styleBtns.length].click();
    $('swipeHint').classList.add('gone');
  }, { passive: true });

  // ---------- Αυτόματη επίδειξη: ένα «χέρι» δοκιμάζει το site μόνο του ----------
  const ghost = document.createElement('div');
  ghost.className = 'ghost';
  ghost.setAttribute('aria-hidden', 'true');
  ghost.innerHTML = '<svg viewBox="0 0 24 24"><path d="M4 2.5l15 9-6.6 1.7L9 20z"/></svg>';
  document.body.appendChild(ghost);
  const pill = $('autoPill');
  class Stop extends Error {}
  let autoRun = 0;
  let userTook = false;
  const auto = () => simEl.classList.contains('auto');
  const wait = (ms: number, id: number) =>
    new Promise<void>((res, rej) => setTimeout(() => (id === autoRun ? res() : rej(new Stop())), ms));
  const inMock = (sel: string) => curMock().querySelector<HTMLElement>(sel);

  async function point(el: HTMLElement | null, id: number) {
    if (!el) return;
    const body = el.closest<HTMLElement>('.mk-body');
    if (body) {
      const br = body.getBoundingClientRect(), r = el.getBoundingClientRect();
      if (r.top < br.top + 10 || r.bottom > br.bottom - 10) {
        body.scrollTo({ top: body.scrollTop + r.top - br.top - 70, behavior: 'smooth' });
        await wait(600, id);
      }
    }
    // δείχνει τη γραμμή εργαλείων της ενότητας, όπως όταν περνάς το ποντίκι
    mSite.querySelectorAll('.hot').forEach((x) => x.classList.remove('hot'));
    el.closest('.blk, .mk-hero')?.classList.add('hot');
    const r = el.getBoundingClientRect();
    if (!r.width || r.top < 0 || r.bottom > innerHeight) { ghost.classList.remove('on'); return; }
    ghost.classList.add('on');
    ghost.style.transform = `translate(${r.left + r.width * 0.5}px, ${r.top + r.height * 0.55}px)`;
    await wait(820, id);
  }
  async function tap(el: HTMLElement | null, id: number, after = 700) {
    if (!el) return;
    await point(el, id);
    ghost.classList.remove('press');
    void ghost.offsetWidth;
    ghost.classList.add('press');
    el.click();
    await wait(after, id);
  }
  async function control(g: string, sel: string, id: number) {
    const el = ctrl.querySelector<HTMLElement>(sel);
    if (!el || el.getAttribute('aria-pressed') === 'true') return;
    if (mobile.matches) {
      const t = ctrl.querySelector<HTMLElement>(`.ctabs [data-g="${g}"]`);
      if (t && t.getAttribute('aria-selected') !== 'true') await tap(t, id, 380);
    }
    await tap(el, id, 1150);
  }
  async function typeName(text: string, id: number) {
    if (input.value === text) return;
    if (mobile.matches) await tap(ctrl.querySelector<HTMLElement>('.ctabs [data-g="name"]'), id, 300);
    await point(input, id);
    input.value = '';
    for (const ch of text) {
      input.value += ch;
      input.dispatchEvent(new Event('input'));
      await wait(75, id);
    }
    await wait(800, id);
  }
  async function editText(el: HTMLElement, text: string, id: number) {
    await point(el, id);
    el.classList.add('editing');
    const t = (texts[tk()] ??= {});
    for (let i = 1; i <= text.length; i++) {
      t.h = text.slice(0, i);
      el.textContent = t.h;
      await wait(55, id);
    }
    el.classList.remove('editing');
    await wait(700, id);
  }
  async function book(sheetSel: string, id: number) {
    await tap(inMock(`${sheetSel} [data-day="1"]`), id, 550);
    await tap(inMock(`${sheetSel} [data-slot]:not(:disabled)`), id, 550);
    await tap(inMock(`${sheetSel} [data-confirm]`), id, 1600);
    await tap(inMock(`${sheetSel} .sh-done [data-sheet-close]`), id, 700);
  }

  const scenes: ((id: number) => Promise<void>)[] = [
    // Φούρνος: e-shop με καλάθι
    async (id) => {
      await control('mode', '#mode [data-m="site"]', id);
      await control('kind', '#kinds [data-k="bakery"]', id);
      await typeName('Φούρνος Ελένη', id);
      await control('style', '#styles [data-s="modern"]', id);
      await tap(inMock('#sNav [data-go="1"]'), id, 900);
      await tap(inMock('#sItems [data-add="0"]'), id, 650);
      await tap(inMock('#sItems [data-add="2"]'), id, 650);
      await tap(inMock('#sCartBtn'), id, 1000);
      await tap(inMock('#sSheet [data-checkout]'), id, 1600);
      await tap(inMock('#sSheet .sh-done [data-sheet-close]'), id, 900);
      // τι βλέπει ο ιδιοκτήτης
      await tap($('ownNote'), id, 1400);
      await tap(inMock('#aList li:first-child [data-st]'), id, 1100);
      await tap(inMock('#aList li:first-child [data-st]'), id, 1300);
      await control('mode', '#mode [data-m="site"]', id);
    },
    // Ταβέρνα: ο επισκέπτης «χτίζει» μόνος του τη σελίδα
    async (id) => {
      delete lay.restaurant;
      delete texts.restaurant;
      await control('kind', '#kinds [data-k="restaurant"]', id);
      await control('style', '#styles [data-s="elegant"]', id);
      await editText($('sHead'), 'Θαλασσινά με θέα το λιμάνι.', id);
      await tap(inMock('.blk[data-b="gal"] [data-bmv="-1"]'), id, 1400);
      await tap(inMock('[data-badd-open]'), id, 800);
      await tap(inMock('.blk-menu [data-badd="cards"]'), id, 1600);
      $('sBody').scrollTo({ top: 0, behavior: 'smooth' });
      await wait(600, id);
      await tap(inMock('.mk-hero [data-hero-cycle]'), id, 1700);
    },
    // Γυμναστήριο: κράτηση θέσης, τολμηρό ύφος
    async (id) => {
      await control('kind', '#kinds [data-k="gym"]', id);
      await control('style', '#styles [data-s="bold"]', id);
      await tap(inMock('#sCta'), id, 900);
      await book('#sSheet', id);
    },
    // Κομμωτήριο: εφαρμογή, κομψό ύφος, δικό του όνομα και χρώμα
    async (id) => {
      await control('kind', '#kinds [data-k="beauty"]', id);
      await typeName('Studio Μαρία', id);
      await control('style', '#styles [data-s="elegant"]', id);
      await control('color', '#swatches [data-c="#B5477A"]', id);
      await control('mode', '#mode [data-m="app"]', id);
      await tap(inMock('#pTabs [data-tab-go="1"]'), id, 800);
      await tap(inMock('#pList [data-book="1"]'), id, 900);
      await book('#pSheet', id);
      await tap(inMock('#pTabs [data-tab-go="0"]'), id, 700);
    },
    // Ξενοδοχείο: νέον ύφος και βόλτα στη σελίδα
    async (id) => {
      await control('mode', '#mode [data-m="site"]', id);
      await control('kind', '#kinds [data-k="hotel"]', id);
      await control('color', '#swatches [data-c="auto"]', id);
      await control('style', '#styles [data-s="neon"]', id);
      await typeName('Aegean Suites', id);
      // AI βοηθός και αγγλικά
      await tap(inMock('[data-bot-open]'), id, 900);
      await tap(inMock('#botQuick [data-bot-q="book"]'), id, 1700);
      await tap(inMock('[data-bot-close]'), id, 600);
      await tap(inMock('[data-lang-toggle]'), id, 1800);
      await tap(inMock('[data-lang-toggle]'), id, 900);
      // το ίδιο site σε tablet και κινητό
      const dsw = $('devSw');
      if (dsw.getBoundingClientRect().width > 0) {
        await tap(dsw.querySelector<HTMLElement>('[data-dev="tablet"]'), id, 1500);
        await tap(dsw.querySelector<HTMLElement>('[data-dev="phone"]'), id, 1800);
        await tap(dsw.querySelector<HTMLElement>('[data-dev="desktop"]'), id, 1200);
      }
      ghost.classList.remove('on');
      const body = $('sBody');
      body.scrollTo({ top: 520, behavior: 'smooth' });
      await wait(1900, id);
      body.scrollTo({ top: 0, behavior: 'smooth' });
      await wait(1300, id);
    },
  ];

  function endAuto() {
    autoRun++;
    ghost.classList.remove('on', 'press');
    mSite.querySelectorAll('.hot, .editing').forEach((x) => x.classList.remove('hot', 'editing'));
    if (botOpen) { botOpen = false; paintBot(); }
    if (userTook) { past.length = 0; future.length = 0; updHist(); }
    pill.hidden = true;
    simEl.classList.remove('auto');
  }
  async function autopilot() {
    if (auto()) return;
    const id = ++autoRun;
    pill.hidden = false;
    simEl.classList.add('auto');
    log(['&gt; autopilot --demo', '<span class="ok">✓ ξεκίνησε</span>']);
    try {
      for (let loop = 0; loop < 3; loop++) for (const scene of scenes) await scene(id);
    } catch (e) {
      if (!(e instanceof Stop)) throw e;
    }
    if (id === autoRun) endAuto();
  }
  // Με το πρώτο πραγματικό άγγιγμα ο έλεγχος περνά στον επισκέπτη
  simEl.addEventListener('pointerdown', (e) => {
    if (e.isTrusted && auto()) { userTook = true; endAuto(); }
  }, true);
  addEventListener('keydown', () => { if (auto()) { userTook = true; endAuto(); } });
  addEventListener('scroll', () => ghost.classList.remove('on'), { passive: true });
  $('simauto').addEventListener('click', () => { userTook = false; setTimeout(autopilot, 250); });
  // Ξεκινά μόνο του όταν το preview φανεί στην οθόνη (και σταματά όταν φύγει)
  let startTimer: ReturnType<typeof setTimeout>;
  if (!reduce && 'IntersectionObserver' in window) {
    new IntersectionObserver(([en]) => {
      const visible = en.isIntersecting && en.intersectionRatio >= 0.35;
      clearTimeout(startTimer);
      if (visible && !userTook && !auto()) startTimer = setTimeout(autopilot, 1400);
      if (!visible && auto()) endAuto();
    }, { threshold: [0, 0.35, 0.6] }).observe(viewEl);
  }

  mSite.addEventListener('click', onAction);
  mApp.addEventListener('click', onAction);
  mAdm.addEventListener('click', onAction);
  $('ownNote').addEventListener('click', () => ctrl.querySelector<HTMLElement>('#mode [data-m="admin"]')!.click());

  // ---------- Desktop / Tablet / Κινητό ----------
  const devBtns = [...document.querySelectorAll<HTMLButtonElement>('#devSw [data-dev]')];
  devBtns.forEach((b) => b.addEventListener('click', () => {
    if (dev !== b.dataset.dev) pushHist();
    dev = b.dataset.dev as Dev;
    devBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    buildStatus();
    paint({ log: false });
    log([`&gt; viewport --${dev}`, `<span class="ok">✓ responsive layout</span>`]);
  }));

  // ---------- Μέσα στο site: εμφάνιση στο scroll και κίνηση στο hero ----------
  const sBody = $('sBody');
  const seenBlk = new Set<string>();

  // Ο επισκέπτης γράφει πάνω σε οποιοδήποτε κείμενο του preview
  const edOf = (e: Event) => ((e.target as HTMLElement).closest ? ((e.target as HTMLElement).closest('[data-ed]') as HTMLElement | null) : null);
  for (const m of [mSite, mApp]) {
    m.addEventListener('input', (e) => {
      const el = edOf(e);
      if (!el) return;
      (texts[tk()] ??= {})[el.dataset.ed!] = (el.textContent ?? '').slice(0, 140);
      if (el.dataset.ed === 'h') $('pCardTitle').textContent = T('h', langBase().headline);
    });
    m.addEventListener('keydown', (e) => {
      const el = edOf(e);
      if (el && e.key === 'Enter') { e.preventDefault(); el.blur(); }
    });
    m.addEventListener('paste', (e) => {
      if (!edOf(e)) return;
      e.preventDefault();
      document.execCommand('insertText', false, (e.clipboardData?.getData('text/plain') ?? '').replace(/\s+/g, ' '));
    });
    m.addEventListener('focusout', (e) => {
      const el = edOf(e);
      if (!el) return;
      const t = texts[tk()];
      const k = el.dataset.ed!;
      if (t && !(t[k] ?? '').trim()) delete t[k];
      // περνάει την αλλαγή παντού (λίστες, κάρτες, εφαρμογή, admin)
      setTimeout(() => paint({ log: false }), 0);
      log(['&gt; content.edit', '<span class="ok">✓ το κείμενο άλλαξε</span>']);
    });
  }
  const revealIO = 'IntersectionObserver' in window && !reduce
    ? new IntersectionObserver((ens) => ens.forEach((en) => {
        if (en.isIntersecting) { en.target.classList.add('in'); seenBlk.add((en.target as HTMLElement).dataset.rk ?? ''); revealIO!.unobserve(en.target); }
      }), { root: sBody, threshold: 0.15 })
    : null;
  function armReveal() {
    if (!revealIO) return;
    sBody.querySelectorAll<HTMLElement>('#sBlocks .blk, .mk-foot2>div').forEach((e) => {
      const key = state.kind + ':' + (e.dataset.b ?? e.className);
      if (e.classList.contains('rv') || seenBlk.has(key)) return;
      e.classList.add('rv');
      e.dataset.rk = key;
      revealIO.observe(e);
    });
  }
  sBody.addEventListener('scroll', () => {
    if (reduce || state.page !== 0) return;
    const y = sBody.scrollTop;
    const pic = mSite.querySelector<HTMLElement>('.mk-hero .mk-pic');
    const copy = mSite.querySelector<HTMLElement>('.mk-hero .mk-copy');
    if (pic) pic.style.transform = `translateY(${(-y * 0.12).toFixed(1)}px)`;
    if (copy) copy.style.opacity = String(Math.max(0.15, 1 - y / 420));
  }, { passive: true });
  addEventListener('keydown', (e) => { if (e.key === 'Escape' && sheet) { sheet = null; syncSheet(); } });

  // Φόρμα επικοινωνίας του demo
  $('sForm').addEventListener('submit', (e) => {
    e.preventDefault();
    $('sFormOk').hidden = false;
    log(['&gt; form.submit', '<span class="ok">✓ received</span>']);
  });

  // Όνομα
  let debounce: ReturnType<typeof setTimeout>;
  input.addEventListener('input', (e) => {
    if (e.isTrusted) nameTouched = input.value.trim() !== '';
    render({ log: false });
    clearTimeout(debounce);
    debounce = setTimeout(() => render(), 500);
  });

  // Έκπληξη: τυχαίος κλάδος, ύφος και χρώμα
  const pick = <T,>(a: T[]) => a[(Math.random() * a.length) | 0];
  $('simrandom').addEventListener('click', () => {
    pushHist();
    const kb = pick(kindBtns.filter((b) => b.dataset.k !== state.kind));
    const sb = pick(styleBtns);
    kindBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === kb)));
    styleBtns.forEach((x) => x.setAttribute('aria-pressed', String(x === sb)));
    state.kind = kb.dataset.k as Kind;
    syncDemoName();
    state.style = sb.dataset.s!;
    state.page = 0;
    state.tab = 0;
    resetFlow();
    pickColor(pick(swatches));
    render({ flash: true });
  });

  // «Θέλω κάτι τέτοιο»: συμπληρώνει τη φόρμα επικοινωνίας και πηγαίνει εκεί
  $('simwant').addEventListener('click', () => {
    const msg = document.getElementById('cf-msg') as HTMLTextAreaElement | null;
    const what = state.mode === 'app' ? 'εφαρμογή' : state.mode === 'admin' ? 'ιστοσελίδα με σύστημα διαχείρισης' : 'ιστοσελίδα';
    const text =
      `Γεια σας! Θα ήθελα ${what} για «${name()}» (${preset().label}).\n` +
      `Από το simulator μου άρεσε το ύφος «${styleLabel()}» με χρώμα ${color()}.\n` +
      `${specText()}\n` +
      `Το σχέδιο: ${shareURL()}`;
    if (msg) msg.value = text;
    document.getElementById('contact')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth' });
    setTimeout(() => (document.getElementById('cf-name') as HTMLInputElement | null)?.focus({ preventScroll: true }), reduce ? 0 : 700);
  });

  // ---------- Link σχεδίου: οι επιλογές μπαίνουν στο URL ----------
  function shareURL() {
    const q = new URLSearchParams({
      s: [state.kind, state.style, state.mode, state.color.replace('#', ''), state.flip ? 1 : 0, dev].join('.'),
      ...(nameTouched ? { n: name() } : {}),
      l: [curLay().hero, ...curLay().blocks].join('-'),
      ...(state.font !== 'auto' || state.corner !== 'auto' ? { f: `${state.font}.${state.corner}` } : {}),
      ...(texts[tk()]?.h ? { t: texts[tk()]!.h! } : {}),
    });
    return `${location.origin}${location.pathname}?${q}#lab`;
  }
  function applyShared(): boolean {
    const q = new URLSearchParams(location.search);
    const raw = q.get('s');
    if (!raw) return false;
    const [k, st, m, c, f, d] = raw.split('.');
    if (k in presets) state.kind = k as Kind;
    if (styles.some((x) => x.id === st)) state.style = st;
    if (m === 'site' || m === 'app' || m === 'admin') state.mode = m;
    if (c === 'auto') pickColor('auto');
    else if (/^[0-9a-f]{6}$/i.test(c ?? '')) { const hex = '#' + c.toUpperCase(); pickColor(hex, !swatches.includes(hex)); }
    state.flip = f === '1';
    if (d === 'tablet' || d === 'phone') dev = d;
    const lq = (q.get('l') ?? '').split('-');
    if (lq[0] && lq[0] in heroLabels) {
      const bl = lq.slice(1).filter((x): x is Block => x in blockLabels);
      lay[state.kind] = { hero: lq[0] as Hero, blocks: bl.length ? [...new Set(bl)] : [...layouts[state.kind].blocks] };
    }
    const [fq, rq] = (q.get('f') ?? '').split('.');
    if (fontBtns.some((x) => x.dataset.f === fq)) state.font = fq;
    if (cornerBtns.some((x) => x.dataset.r === rq)) state.corner = rq;
    fontBtns.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.f === state.font)));
    cornerBtns.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.r === state.corner)));
    const tq = q.get('t');
    if (tq) (texts[tk()] ??= {}).h = tq.slice(0, 110);
    const nm = q.get('n');
    if (nm && nm !== presets[state.kind].demo) { input.value = nm.slice(0, 26); nameTouched = true; } else syncDemoName();
    kindBtns.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.k === state.kind)));
    styleBtns.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.s === state.style)));
    document.querySelectorAll<HTMLButtonElement>('#mode > button').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.m === state.mode)));
    devBtns.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.dev === dev)));
    flipBtn.setAttribute('aria-pressed', String(state.flip));
    return true;
  }
  const shareBtn = $('simshare');
  const shareLabel = shareBtn.innerHTML;
  async function copyText(url: string) {
    try { await navigator.clipboard.writeText(url); return true; } catch {
      const t = document.createElement('textarea');
      t.value = url; document.body.appendChild(t); t.select();
      let ok = false;
      try { ok = document.execCommand('copy'); } catch { ok = false; }
      t.remove();
      return ok;
    }
  }
  shareBtn.addEventListener('click', async () => {
    const url = shareURL();
    const ok = await copyText(url);
    shareBtn.innerHTML = ok ? 'Αντιγράφηκε <span class="k" aria-hidden="true">✓</span>' : 'Δεν αντιγράφηκε';
    setTimeout(() => (shareBtn.innerHTML = shareLabel), 1800);
    log(['&gt; share.link', `<span class="ok">✓ ${ok ? 'αντιγράφηκε στο πρόχειρο' : 'αντέγραψε από τη γραμμή διευθύνσεων'}</span>`]);
    if (!ok) history.replaceState(null, '', url);
  });

  // ---------- AI βοηθός (demo με έτοιμες απαντήσεις) ----------
  type BotMsg = { me: boolean; html: string };
  let botMsgs: BotMsg[] = [];
  let botOpen = false;
  let botTyping = false;
  let botSeen = false;
  const norm = (t: string) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  const botGreet = () => (state.lang === 'en'
    ? `Hi! I'm the assistant of ${name()}. How can I help?`
    : `Γεια σου! Είμαι ο βοηθός του «${name()}». Πώς μπορώ να βοηθήσω;`);
  function botReset() { botMsgs = [{ me: false, html: esc(botGreet()) }]; botTyping = false; }
  function botQuick(): [string, string][] {
    const cartK = preset().flow === 'cart';
    return state.lang === 'en'
      ? [['hours', 'Opening hours'], ['book', cartK ? 'Place an order' : 'Book now'], ['where', 'Where are you?'], ['offer', cartK ? 'What do you have?' : 'Services']]
      : [['hours', 'Ωράριο'], ['book', cartK ? 'Θέλω να παραγγείλω' : 'Θέλω να κλείσω'], ['where', 'Πού βρίσκεστε;'], ['offer', cartK ? 'Τι έχετε;' : 'Υπηρεσίες']];
  }
  function botReply(q: string): string {
    const p = preset();
    const isEn = state.lang === 'en';
    const t = norm(q);
    const cartK = p.flow === 'cart';
    const btn = `<button type="button" class="mk-btn bot-cta" ${cartK ? 'data-go="1"' : 'data-book="-1"'}>${esc(p.cta)}</button>`;
    if (/(ωραρ|ωρες|ανοιχτ|κλειστ|hour|open|clos)/.test(t)) return isEn ? `We're open ${esc(p.hours)}.` : `Είμαστε ανοιχτά ${esc(p.hours)}.`;
    if (/(κρατ|ραντεβ|κλεισ|παραγγ|θεση|book|order|reserv|appoint)/.test(t)) return (isEn ? 'Sure! You can do it online in a few seconds:' : 'Βεβαίως! Γίνεται online σε λίγα δευτερόλεπτα:') + btn;
    if (/(που |που;|που$|διευθ|βρισκ|parking|where|address|locat)/.test(t)) return isEn ? '12 Example Street. There is a map on the Contact page.' : 'Οδός Παραδείγματος 12. Θα βρεις χάρτη στη σελίδα Επικοινωνία.';
    if (/(τιμ|κοστ|ποσο|price|cost)/.test(t)) return isEn ? 'For prices, have a look at our list or ask us via the contact form.' : 'Για τιμές, δες τον κατάλογό μας ή ρώτα μας από τη φόρμα επικοινωνίας.';
    if (/(τι |τι;|εχετε|προσφερ|υπηρεσ|καταλογ|μενου|menu|servic|offer|what)/.test(t)) return (isEn ? 'Here is what we offer: ' : 'Να τι προσφέρουμε: ') + p.items.slice(0, 4).map((i) => `<b>${esc(i.n)}</b>`).join(', ') + '.';
    if (/(γεια|καλημερ|καλησπερ|hello|^hi|hey)/.test(t)) return esc(botGreet());
    if (/(ευχαριστ|thank)/.test(t)) return isEn ? 'You are welcome! 😊' : 'Να είσαι καλά! 😊';
    return isEn
      ? 'I can help with opening hours, bookings and our services. For anything else, write to us via the contact form.'
      : 'Μπορώ να βοηθήσω με ωράριο, κρατήσεις και υπηρεσίες. Για κάτι άλλο, γράψε μας στη φόρμα επικοινωνίας.';
  }
  let botTimer: ReturnType<typeof setTimeout>;
  function botAsk(label: string, key?: string) {
    botMsgs.push({ me: true, html: esc(label) });
    botTyping = true;
    paintBot();
    clearTimeout(botTimer);
    botTimer = setTimeout(() => {
      botTyping = false;
      botMsgs.push({ me: false, html: botReply(key ?? label) });
      if (botMsgs.length > 14) botMsgs = botMsgs.slice(-14);
      paintBot();
    }, 750);
    log([`&gt; ai.chat <span class="hl">"${esc(label)}"</span>`, '<span class="ok">✓ απάντηση</span>']);
  }
  function paintBot() {
    mSite.classList.toggle('no-bot', !state.bot);
    $('botName').textContent = name();
    $('botSub').textContent = state.lang === 'en' ? 'AI assistant · online' : 'AI βοηθός · online';
    ($('botIn') as HTMLInputElement).placeholder = state.lang === 'en' ? 'Ask a question…' : 'Γράψε μια ερώτηση…';
    setHTML($('botLog'), botMsgs.map((m) => `<div class="bm${m.me ? ' me' : ''}">${m.html}</div>`).join('') + (botTyping ? '<div class="bm typing"><i></i><i></i><i></i></div>' : ''));
    setHTML($('botQuick'), botQuick().map(([k, l]) => `<button type="button" data-bot-q="${k}">${esc(l)}</button>`).join(''));
    $('botPanel').hidden = !botOpen;
    $('sBot').classList.toggle('open', botOpen);
    $('sBot').classList.toggle('seen', botSeen);
    const lg = $('botLog');
    lg.scrollTop = lg.scrollHeight;
  }

  // ---------- Εκτίμηση χρόνου και λειτουργιών (χωρίς τιμές) ----------
  function specInfo() {
    const p = presets[state.kind];
    const L = curLay();
    const cartK = p.flow === 'cart';
    const feats = ['Σχεδιασμός από το μηδέν', 'Responsive: κινητό, tablet, desktop', 'SEO, Google Analytics & Search Console'];
    if (cartK) feats.push('Καλάθι & online πληρωμές', 'Αποστολές (courier, BoxNow)');
    else feats.push('Online κρατήσεις με ημερολόγιο');
    feats.push('Διαχείριση παραγγελιών/κρατήσεων (admin)');
    if (state.mode === 'app') feats.push('Εφαρμογή για iPhone & Android', 'Ειδοποιήσεις push');
    if (state.bot) feats.push('AI βοηθός (chatbot)');
    if (state.bi || state.lang === 'en') feats.push('Δίγλωσσο site (EL / EN)');
    if (userLogo) feats.push('Το λογότυπό σου και τα χρώματά του');
    feats.push(`${L.blocks.length} ενότητες στην αρχική`);
    let lo = cartK ? 5 : 3, hi = cartK ? 8 : 5;
    if (state.mode === 'app') { lo = 8; hi = 12; }
    if (state.bot) { lo += 1; hi += 1; }
    if (state.bi || state.lang === 'en') { lo += 1; hi += 1; }
    if (L.blocks.length > 6) hi += 1;
    return { lo, hi, feats };
  }
  function specHTML() {
    const { lo, hi, feats } = specInfo();
    return `<div class="spec-wk"><small>Εκτίμηση χρόνου</small><b>${lo}–${hi} εβδομάδες</b></div><ul>${feats.map((f) => `<li>${esc(f)}</li>`).join('')}</ul><small class="spec-note">Ενδεικτικό, χωρίς δέσμευση. Το ακριβές χρονοδιάγραμμα το συμφωνούμε μαζί.</small>`;
  }
  function specText() {
    const { lo, hi, feats } = specInfo();
    return `Εκτίμηση: ${lo}–${hi} εβδομάδες\nΛειτουργίες: ${feats.join(', ')}`;
  }

  // ---------- Αναίρεση / επανάληψη ----------
  const past: string[] = [];
  const future: string[] = [];
  const snapshot = () => JSON.stringify({ st: { ...state, page: 0, tab: 0 }, lay, texts, n: input.value, nt: nameTouched, dev });
  function pushSnap(sn: string) {
    if (past[past.length - 1] === sn) return;
    past.push(sn);
    if (past.length > 80) past.shift();
    future.length = 0;
    updHist();
  }
  const pushHist = () => pushSnap(snapshot());
  function updHist() {
    ($('simUndo') as HTMLButtonElement).disabled = !past.length;
    ($('simRedo') as HTMLButtonElement).disabled = !future.length;
  }
  function restoreSnap(sn: string) {
    const o = JSON.parse(sn);
    const kindChanged = o.st.kind !== state.kind;
    Object.assign(state, o.st);
    for (const k of Object.keys(lay)) delete (lay as Record<string, unknown>)[k];
    Object.assign(lay, o.lay);
    for (const k of Object.keys(texts)) delete texts[k];
    Object.assign(texts, o.texts);
    input.value = o.n;
    nameTouched = o.nt;
    dev = o.dev;
    if (kindChanged) resetFlow();
    syncControls();
    render({ flash: true });
  }
  function undo() {
    if (!past.length) return;
    future.push(snapshot());
    restoreSnap(past.pop()!);
    updHist();
    log(['&gt; history.undo', '<span class="ok">✓ αναίρεση</span>']);
  }
  function redo() {
    if (!future.length) return;
    past.push(snapshot());
    restoreSnap(future.pop()!);
    updHist();
    log(['&gt; history.redo', '<span class="ok">✓ επανάληψη</span>']);
  }
  function syncControls() {
    kindBtns.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.k === state.kind)));
    styleBtns.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.s === state.style)));
    fontBtns.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.f === state.font)));
    cornerBtns.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.r === state.corner)));
    document.querySelectorAll<HTMLButtonElement>('#mode > button').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.m === state.mode)));
    devBtns.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.dev === dev)));
    flipBtn.setAttribute('aria-pressed', String(state.flip));
    $('simbot').setAttribute('aria-pressed', String(state.bot));
    if (state.color === 'auto') pickColor('auto');
    else pickColor(state.color, !swatches.includes(state.color));
  }
  $('simUndo').addEventListener('click', undo);
  $('simRedo').addEventListener('click', redo);
  // Κείμενα: ένα βήμα αναίρεσης για κάθε επεξεργασία
  let editSnap = '';
  for (const m of [mSite, mApp]) {
    m.addEventListener('focusin', (e) => { if (edOf(e)) editSnap = snapshot(); });
    m.addEventListener('focusout', (e) => { if (edOf(e) && editSnap) { const sn = editSnap; editSnap = ''; setTimeout(() => { if (snapshot() !== sn) pushSnap(sn); }, 0); } });
  }
  let nameSnap = '';
  input.addEventListener('focus', () => { nameSnap = snapshot(); });
  input.addEventListener('change', () => { if (nameSnap) pushSnap(nameSnap); nameSnap = ''; });

  // ---------- Πλήρης οθόνη ----------
  function toggleFs(on = !simEl.classList.contains('fs')) {
    simEl.classList.toggle('fs', on);
    document.documentElement.classList.toggle('sim-fs', on);
    const b = $('simFs');
    b.setAttribute('aria-pressed', String(on));
    b.setAttribute('aria-label', on ? 'Έξοδος από πλήρη οθόνη' : 'Πλήρης οθόνη');
    b.title = on ? 'Έξοδος (Esc)' : 'Πλήρης οθόνη';
    log([`&gt; view --${on ? 'fullscreen' : 'normal'}`, '<span class="ok">✓</span>']);
  }
  $('simFs').addEventListener('click', () => toggleFs());

  // ---------- Λογότυπο / φωτογραφία ----------
  const upLogo = $('upLogo') as HTMLInputElement;
  const upPhoto = $('upPhoto') as HTMLInputElement;
  function okImg(f: File | undefined): f is File {
    if (!f) return false;
    if (!f.type.startsWith('image/') || f.size > 12e6) {
      log(['&gt; upload', '<span class="hl">✕ μόνο εικόνες έως 12MB</span>']);
      return false;
    }
    return true;
  }
  function brandUi() {
    $('upLogoT').textContent = userLogo ? '✓ Λογότυπο' : '＋ Λογότυπο';
    $('upPhotoT').textContent = userPhoto ? '✓ Φωτογραφία' : '＋ Φωτογραφία';
    $('upLogoL').classList.toggle('done', !!userLogo);
    $('upPhotoL').classList.toggle('done', !!userPhoto);
    $('upClear').hidden = !userLogo && !userPhoto;
  }
  upLogo.addEventListener('change', async () => {
    const f = upLogo.files?.[0];
    upLogo.value = '';
    if (!okImg(f)) return;
    pushHist();
    if (userLogo) URL.revokeObjectURL(userLogo);
    userLogo = URL.createObjectURL(f);
    const c = await logoColor(userLogo);
    if (c) { pickColor(c, true); custom.value = c.toLowerCase(); }
    brandUi();
    render({ flash: true });
    log(['&gt; brand.logo', `<span class="ok">✓ λογότυπο${c ? ` · χρώμα ${c}` : ''}</span>`]);
  });
  upPhoto.addEventListener('change', () => {
    const f = upPhoto.files?.[0];
    upPhoto.value = '';
    if (!okImg(f)) return;
    if (userPhoto) URL.revokeObjectURL(userPhoto);
    userPhoto = URL.createObjectURL(f);
    ($('sPh') as HTMLImageElement).removeAttribute('src');
    brandUi();
    render({ flash: true });
    log(['&gt; brand.photo', '<span class="ok">✓ η φωτογραφία σου στο hero</span>']);
  });
  $('upClear').addEventListener('click', () => {
    if (userLogo) URL.revokeObjectURL(userLogo);
    if (userPhoto) URL.revokeObjectURL(userPhoto);
    userLogo = userPhoto = null;
    ($('sPh') as HTMLImageElement).removeAttribute('src');
    if (!swatches.includes(state.color)) pickColor('auto');
    brandUi();
    render({ flash: true });
  });

  // ---------- AI βοηθός: κουμπί on/off και ερωτήσεις ----------
  $('simbot').addEventListener('click', () => {
    pushHist();
    state.bot = !state.bot;
    botOpen = false;
    $('simbot').setAttribute('aria-pressed', String(state.bot));
    paint({ log: false });
    log([`&gt; ai.chatbot --${state.bot ? 'on' : 'off'}`, '<span class="ok">✓</span>']);
  });
  $('botForm').addEventListener('submit', (e) => {
    e.preventDefault();
    const inp = $('botIn') as HTMLInputElement;
    const v = inp.value.trim();
    if (!v) return;
    inp.value = '';
    botAsk(v);
  });

  // ---------- «Στείλε μου το σχέδιο» ----------
  const sd = $('sdModal');
  let qrLoad: Promise<void> | null = null;
  const loadQR = () => (qrLoad ??= new Promise<void>((res, rej) => {
    const sc = document.createElement('script');
    sc.src = '/vendor/qrcode.js';
    sc.onload = () => res();
    sc.onerror = () => { qrLoad = null; rej(new Error('qr')); };
    document.head.appendChild(sc);
  }));
  async function drawQR() {
    const box = $('sdQr');
    try {
      await loadQR();
      const qr = (window as unknown as { qrcode: (t: number, e: string) => { addData: (s: string) => void; make: () => void; createSvgTag: (o: object) => string } }).qrcode(0, 'L');
      qr.addData(shareURL());
      qr.make();
      box.innerHTML = qr.createSvgTag({ cellSize: 4, margin: 2, scalable: true });
    } catch { box.innerHTML = '<small>Το QR δεν φόρτωσε.</small>'; }
  }
  function openSd() {
    sd.hidden = false;
    document.documentElement.classList.add('sim-fs');
    setHTML($('sdSpec'), specHTML());
    $('sdStatus').textContent = '';
    drawQR();
    setTimeout(() => ($('sdEmail') as HTMLInputElement).focus(), 60);
  }
  function closeSd() {
    sd.hidden = true;
    if (!simEl.classList.contains('fs')) document.documentElement.classList.remove('sim-fs');
  }
  $('simsend').addEventListener('click', openSd);
  sd.addEventListener('click', (e) => { if (e.target === sd || (e.target as HTMLElement).closest('[data-sd-close]')) closeSd(); });
  $('sdCopy').addEventListener('click', async () => {
    const ok = await copyText(shareURL());
    $('sdCopy').innerHTML = ok ? 'Αντιγράφηκε <span class="k" aria-hidden="true">✓</span>' : 'Δεν αντιγράφηκε';
    setTimeout(() => ($('sdCopy').innerHTML = 'Αντιγραφή link <span class="k" aria-hidden="true">⧉</span>'), 1800);
  });
  ($('sdForm') as HTMLFormElement).addEventListener('submit', async (e) => {
    e.preventDefault();
    const st = $('sdStatus');
    const email = ($('sdEmail') as HTMLInputElement).value.trim();
    const nm = ($('sdName') as HTMLInputElement).value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      st.className = 'status err';
      st.textContent = 'Γράψε ένα σωστό email.';
      return;
    }
    const btn = ($('sdForm') as HTMLFormElement).querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true;
    st.className = 'status';
    st.textContent = 'Αποστολή…';
    const fd = new FormData();
    fd.append('name', nm || 'Επισκέπτης simulator');
    fd.append('contact', email);
    fd.append('website', ($('sdWeb') as HTMLInputElement).value);
    fd.append('message',
      `Ζήτησε το σχέδιό του από τον simulator.\n\n` +
      `Επιχείρηση: ${name()} (${presets[state.kind].label})\n` +
      `Τύπος: ${state.mode === 'app' ? 'Εφαρμογή' : state.mode === 'admin' ? 'Ιστοσελίδα + διαχείριση' : 'Ιστοσελίδα'}\n` +
      `Ύφος: ${styleLabel()} · Χρώμα: ${color()}${state.font !== 'auto' ? ` · Font: ${state.font}` : ''}${state.corner !== 'auto' ? ` · Γωνίες: ${state.corner}` : ''}\n` +
      `Ενότητες: ${curLay().blocks.map((b) => blockLabels[b]).join(', ')}\n` +
      `${specText()}\n\nΣύνδεσμος σχεδίου: ${shareURL()}`);
    try {
      const res = await fetch('/contact.php', { method: 'POST', body: fd });
      const json = await res.json().catch(() => ({}));
      if (!res.ok || !json.ok) throw new Error(json.error || 'send_failed');
      st.className = 'status ok';
      st.textContent = 'Στάλθηκε! Θα σου στείλουμε το σχέδιο και μια πρώτη πρόταση μέσα σε 24 ώρες.';
      log(['&gt; lead.send', '<span class="ok">✓ το σχέδιο στάλθηκε</span>']);
    } catch {
      st.className = 'status err';
      st.textContent = 'Δεν στάλθηκε. Δοκίμασε ξανά ή γράψε μας στο info@preludedma.gr.';
    } finally {
      btn.disabled = false;
    }
  });

  // Πλήκτρα: Esc, Ctrl+Z / Ctrl+Y
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      if (!sd.hidden) { closeSd(); return; }
      if (simEl.classList.contains('fs')) { toggleFs(false); return; }
    }
    if (!(e.ctrlKey || e.metaKey)) return;
    const a = document.activeElement as HTMLElement | null;
    if (a && (a.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(a.tagName))) return;
    const r = simEl.getBoundingClientRect();
    if (r.bottom < 0 || r.top > innerHeight) return;
    const k = e.key.toLowerCase();
    if (k === 'z' && !e.shiftKey) { e.preventDefault(); undo(); }
    else if ((k === 'z' && e.shiftKey) || k === 'y') { e.preventDefault(); redo(); }
  });

  botReset();

  seedOrders();
  if (applyShared()) userTook = true;
  paint();
  if ('IntersectionObserver' in window) {
    new IntersectionObserver((ens, obs) => {
      if (!ens.some((e) => e.isIntersecting)) return;
      obs.disconnect();
      photosOn = true;
      paint({ log: false });
      // οι υπόλοιποι κλάδοι φορτώνουν στο παρασκήνιο για άμεση εναλλαγή
      setTimeout(() => (Object.keys(presets) as Kind[]).forEach((k) => { new Image().src = `/sim/${k}-0.webp`; }), 2500);
    }, { rootMargin: '900px 0px' }).observe(simEl);
  } else { photosOn = true; paint({ log: false }); }
</script>
