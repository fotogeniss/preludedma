---
import '../styles/global.css';
import Globe from '../components/Globe.astro';
import Hud from '../components/Hud.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { site } from '../data/site';
import { services } from '../data/services';

interface Props {
  title?: string;
  description?: string;
  globe?: boolean;
  noindex?: boolean;
}

const { title = site.seoTitle, description = site.description, globe = true, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(site.ogImage, Astro.site);

// Δομημένα δεδομένα για τη Google (schema.org): ποιοι είστε, τι κάνετε, πού.
const address = Object.fromEntries(Object.entries(site.address).filter(([, v]) => v));
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${site.url}/#business`,
      name: site.legalName,
      alternateName: site.name,
      url: site.url,
      logo: `${site.url}/favicon.svg`,
      image: ogImage.href,
      description: site.description,
      email: site.email,
      telephone: site.phone,
      address: { '@type': 'PostalAddress', ...address },
      geo: { '@type': 'GeoCoordinates', ...site.geo },
      areaServed: { '@type': 'Country', name: 'Ελλάδα' },
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Υπηρεσίες',
        itemListElement: services.map((s) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name: s.title, description: s.text },
        })),
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      url: site.url,
      name: site.name,
      inLanguage: 'el-GR',
      publisher: { '@id': `${site.url}/#business` },
    },
  ],
};
---
<!doctype html>
<html lang="el">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="el" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="el_GR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#04050A" />
    {site.analytics.searchConsole && <meta name="google-site-verification" content={site.analytics.searchConsole} />}
    <meta name="format-detection" content="telephone=no" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Tektur:wght@500;700;800;900&family=JetBrains+Mono:wght@400;500;700&family=Commissioner:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Σύμβολο αστερίσκου, χρησιμοποιείται με <svg><use href="#st"/></svg> -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <symbol id="st" viewBox="0 0 100 100">
        <path fill="currentColor" d="M42 0h16l-2 33 23-24 11 11-24 23 34-1v16l-34-2 24 23-11 11-23-24 2 34H42l2-34-23 24-11-11 24-23-34 2V42l34 1-24-23 11-11 23 24z" />
      </symbol>
      <!-- Κρατά μόνο το εξωτερικό περίγραμμα των γραμμάτων (για την κλάση .ol) -->
      <filter id="hollow" x="-10%" y="-20%" width="120%" height="140%" color-interpolation-filters="sRGB">
        <feMorphology in="SourceAlpha" operator="erode" radius="1.6" result="inner" />
        <feComposite in="SourceGraphic" in2="inner" operator="out" result="line" />
        <feGaussianBlur in="line" stdDeviation="6" result="blur" />
        <feComponentTransfer in="blur" result="glow"><feFuncA type="linear" slope="1.8" /></feComponentTransfer>
        <feMerge><feMergeNode in="glow" /><feMergeNode in="line" /></feMerge>
      </filter>
    </svg>

    {globe && <Globe />}
    <div class="grid-bg" aria-hidden="true"></div>
    <div class="scan" aria-hidden="true"></div>
    <Hud />
    <CookieConsent />

    <div class="content">
      <slot />
    </div>

    <script>
      // Κείμενα που «αποκωδικοποιούνται» και μετρητές που ανεβαίνουν
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const glyphs = '!<>-_\\/[]{}=+*^?#01ABCDEFX';

      function scramble(el: HTMLElement, delay: number) {
        const final = el.textContent ?? '';
        if (reduce) return;
        let frame = -Math.round(delay / 16);
        const q = [...final].map((c, i) => ({
          c,
          start: Math.floor(Math.random() * 20) + i * 1.2,
          end: Math.floor(Math.random() * 20) + i * 1.2 + 18,
        }));
        const run = () => {
          let out = '';
          let done = 0;
          for (const it of q) {
            if (frame >= it.end || it.c === ' ') { out += it.c; done++; }
            else if (frame >= it.start) out += glyphs[(Math.random() * glyphs.length) | 0];
            else out += ' ';
          }
          if (frame >= 0) el.textContent = out;
          frame++;
          if (done < q.length) requestAnimationFrame(run);
          else el.textContent = final;
        };
        run();
      }

      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          io.unobserve(e.target);
          const el = e.target as HTMLElement;
          scramble(el, Number(el.dataset.d || 0));
        });
      }, { threshold: 0.4 });
      document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((el, i) => {
        el.dataset.d = String((i % 4) * 140);
        io.observe(el);
      });

      const co = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          co.unobserve(e.target);
          const el = e.target as HTMLElement;
          const to = Number(el.dataset.count);
          const dec = Number(el.dataset.dec || 0);
          const t0 = performance.now();
          const step = (n: number) => {
            const k = reduce ? 1 : Math.min((n - t0) / 1400, 1);
            el.textContent = (to * (1 - Math.pow(1 - k, 3))).toFixed(dec);
            if (k < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        });
      }, { threshold: 0.5 });
      document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => co.observe(el));
    </script>
  </body>
</html>
