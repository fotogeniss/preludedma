# Prelude: ρυθμίσεις Apache για το στατικό site (αντικαθιστά το .htaccess του WordPress)

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Πάντα https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Χωρίς www
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Παλιές διευθύνσεις του WordPress → νέες
  RewriteRule ^about/?$ /#services [NE,L,R=301]
  RewriteRule ^services/?$ /#services [NE,L,R=301]
  RewriteRule ^projects/?$ /#work [NE,L,R=301]
  RewriteRule ^el/ / [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Τα αρχεία του Astro στο /_astro/ έχουν hash στο όνομα, άρα μπορούν να μένουν στην cache για πάντα
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
